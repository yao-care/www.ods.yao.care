---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  lead?: string;
  /** 額外的 JSON-LD。BaseLayout 已給全站 Organization／WebSite，這裡放單頁自己的。 */
  schemas?: unknown[];
}
const { title, description, heading, lead, schemas = [] } = Astro.props;
---

<BaseLayout title={title} description={description} schemas={schemas}>
  <SiteHeader />
  <main id="main">
    <h1>{heading}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>

<style is:global>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  main h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }
  main h2 {
    font-size: var(--text-xl);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  main h3 {
    font-size: var(--text-lg);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  main p,
  main li {
    font-size: var(--text-base);
    line-height: 1.9;
  }
  main p {
    margin-block: 1rem;
  }
  main .lead {
    color: var(--color-ink-soft);
    max-width: 46rem;
  }
  main ul,
  main ol {
    padding-inline-start: 1.75rem;
    display: grid;
    gap: 0.5rem;
  }
  main table {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1.5rem;
  }
  main th,
  main td {
    font-size: var(--text-sm);
    text-align: start;
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }
  main th {
    color: var(--color-ink-soft);
  }
</style>
