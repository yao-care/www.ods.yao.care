---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { SERVICE_LINKS } from '../../site.config.js';
import { CITIZEN_CATEGORIES, CITIZEN_EXAMPLES } from '../../data/citizen-examples.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const registerLink = SERVICE_LINKS.selfRegister('citizens_self_register');

// 列表頁原本只有 BaseLayout 給的全站兩條 schema，/templates/ 則已有 CollectionPage＋麵包屑。
// 這裡補齊，讓民眾端這個入口頁也講得出「它收了哪 9 份文件」。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      name: '民眾正式書件與存證信函範例',
      description:
        '一般民眾對機關的申請書、陳情書、申訴書與說明書，以及個人或企業之間的存證信函，' +
        `共 ${CITIZEN_EXAMPLES.length} 份可直接試做的範例。`,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@type': 'WebSite', url: 'https://www.ods.yao.care/' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: CITIZEN_EXAMPLES.length,
        itemListElement: CITIZEN_EXAMPLES.map((example, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: example.seoTitle,
          url: new URL(`${base}citizens/${example.slug}/`, Astro.site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '民眾文件', item: pageUrl },
      ],
    },
  ],
};

// 民眾端的搜尋幾乎都是問句（「陳情書怎麼寫」「存證信函要寄幾份」），
// 這個入口頁原本只有 CollectionPage，問句型結果一個都吃不到。
const faqPairs = [
  {
    q: '一般民眾寫給機關要用什麼格式？',
    a: '民眾不用公文文別，但要寫清楚幾件事：你是誰、要機關辦什麼、依據是什麼、附了哪些文件。'
      + '反映問題請機關查處用陳情書，申請資格或補助用申請書，'
      + '對已經做出的處理結果有意見用申訴書，機關要求補件用說明書。',
  },
  {
    q: '陳情書要怎麼寫才有用？',
    a: '寫可以確認的事實：發生時間、地點、頻率與造成的影響，不要先替機關認定對方違法。'
      + '請求事項要寫成希望機關採取的具體處理（例如派員稽查、排定會勘），'
      + '並留下可聯絡的方式，機關才回覆得了。',
  },
  {
    q: '存證信函和一般書信差在哪？',
    a: '存證信函由郵局留存一份，證明你在某個日期把某段內容通知給對方，'
      + '在後續爭議中可以拿來證明「已經通知過」。內容本身沒有強制力，'
      + '但催告、定期限、終止契約這類法律行為需要能證明送達，所以才用它。',
  },
  {
    q: '不服機關的決定，該用陳情、訴願還是申訴？',
    a: '要看對象與有沒有期限。訴願針對機關的行政處分，有法定期間，逾期就不受理；'
      + '陳情沒有期限但也沒有拘束力；申訴多半是各法規自訂的內部救濟程序。'
      + '四條路的定義與期限逐條整理在「陳情、請願、訴願、申訴怎麼選」。',
  },
];
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPairs.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
---

<ArticlePage
  schemas={[schema, faq]}
  title="民眾正式書件與存證信函｜公文 AI"
  description="一般民眾可撰寫對機關的申請書、陳情書、申訴書與說明書；個人或企業也可整理存證信函草稿。"
  heading="民眾也有自己的正式書件"
  lead="公文不只存在於機關之間。需要向公家機關提出申請、陳情或申訴，或要正式通知另一個人／企業時，都需要清楚、可審閱的文字。"
>
  <p class="cross">
    你是機關承辦？函、公告、開會通知單、簽的範例在<a href={`${base}cases/`}>公文範例庫</a>，
    文別怎麼選看<a href={`${base}doc-types/`}>文別指南</a>，
    各文別的空白 Word 範本在<a href={`${base}templates/`}>範本下載</a>。
  </p>

  <section class="showcase">
    <div class="section-intro">
      <p class="eyebrow">先看一份示意</p>
      <h2>民眾文件長什麼樣子？</h2>
      <p>
        不用先猜該寫成什麼格式。先從用途找一份示意，會看到系統如何把內容整理成「事實與理由／請求事項／附件」；
        存證信函則另外保留雙方資料與履行期限。
      </p>
    </div>

    <div class="categories">
      {CITIZEN_CATEGORIES.map((category) => (
        <section class="category">
          <h3 class="category-title">{category}</h3>
          <div class="example-grid">
            {CITIZEN_EXAMPLES.filter((example) => example.category === category).map((example) => (
              <a class="example-card" href={`${base}citizens/${example.slug}/`}>
                <div class="card-meta">
                  <span>{example.family === 'notice' ? '存證信函' : '民眾對機關'}</span>
                  <strong>{example.draft.doc_type}</strong>
                </div>
                <h3>{example.seoTitle}</h3>
                <p class="card-lead">{example.lead}</p>
                <div class="document-preview" aria-label={`${example.draft.doc_type}示意`}>
                  <p class="preview-label">先看內容</p>
                  <p><strong>事由</strong>{example.scenario.source}</p>
                  <p><strong>產出</strong>{example.draft.subject}</p>
                </div>
                <span class="card-link">進入模擬操作 →</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <p class="showcase-note">點進去會進入和公文範例相同的仿真流程；內容為虛構示意，實際草稿仍應逐項確認。</p>
  </section>

  <section>
    <h2>民眾對機關：把事情與請求寫清楚</h2>
    <p class="guide-link">
      不服機關的決定時，陳情、請願、訴願與申訴是四條不同的路，差別在期限與遞給誰 ——
      訴願只有三十日。先看<a href={`${base}citizens/which-route/`}>怎麼選</a>再動筆。
    </p>
    <p>
      個人可以選擇申請書、陳情書、申訴書或說明書，從事情經過與理由開始整理，
      再列出希望機關處理的事項。系統使用「事實與理由／請求事項／附件」結構，
      不把一般建議擅自寫成法律上當然成立的權利，也不替使用者虛構法條或證據。
    </p>
    <ul>
      <li><strong>申請書：</strong>提出申請內容、相關事實與希望的處理結果。</li>
      <li><strong>陳情書：</strong>整理問題經過、影響與請機關查明或處理的事項。</li>
      <li><strong>申訴書：</strong>說明對原處理結果的不同意見與請求重新查明的理由。</li>
      <li><strong>說明書：</strong>把案件背景與補充說明整理成機關看得懂的格式。</li>
    </ul>
  </section>

  <section>
    <h2>民眾對民眾／企業：存證信函草稿</h2>
    <p class="guide-link">
      內容以外的事——存證費多少、要準備幾份、塗改字數上限、怎麼交寄、寄了有什麼效力——
      整理在<a href={`${base}citizens/certified-letter-guide/`}>存證信函怎麼寄</a>，數字出自中華郵政官方規定。
    </p>
    <p>
      房東、房客、消費者、商家或其他個人與企業之間，需要留下正式通知內容時，
      可以整理存證信函草稿。填寫寄件人、收件人、雙方地址、事實經過、請求事項與履行／回覆期限，
      產出後先人工確認，再下載純文字或 Word 文件。
    </p>
    <p>
      存證信函功能是文字整理與排版協助，不代表已完成郵寄、送達或法律審查；
      重要案件仍應依需要諮詢律師或其他專業人士。
    </p>
  </section>

  <section>
    <h2>怎麼開始</h2>
    <ol>
      <li>以 Google 或 LINE 登入，建立個人工作區。</li>
      <li>選擇民眾對機關書件或存證信函，填寫事實與必要欄位。</li>
      <li>看格式檢核結果，人工修改後下載純文字或 Word 文件。</li>
    </ol>
    <p><a class="primary" {...registerLink}>建立個人工作區</a></p>
  </section>

  <section>
    <h2>個資怎麼處理</h2>
    <p>
      寄件人、收件人、地址、聯絡方式、期限與附件等結構化欄位留在自己的工作區，
      用於本機預覽與匯出；送往模型的事實敘述會先經過去識別化。去識別化服務不可用時，
      民眾文件改用本機規則引擎產出，不把原文送往模型。
    </p>
  </section>
</ArticlePage>

<style>
  .guide-link {
    background: var(--color-bg-light);
    padding: 1rem 1.25rem;
    border-radius: 0.375rem;
    font-size: var(--text-sm);
    line-height: 1.9;
  }

  .cross {
    margin-top: 0;
    padding: 1rem 0;
    border-block: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: 1.9;
  }

  .cross a {
    color: var(--color-primary);
  }

  .showcase {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg-light);
  }

  .section-intro {
    max-width: 48rem;
  }

  .section-intro h2 {
    margin-top: 0.25rem;
  }

  .section-intro p:last-child {
    margin-bottom: 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .example-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .categories {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .category {
    display: grid;
    gap: 0.75rem;
  }

  .category-title {
    margin: 0;
    color: var(--color-primary);
  }

  .example-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.625rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
  }

  a.example-card {
    color: var(--color-text);
    text-decoration: none;
  }

  a.example-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-card-hover);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .card-meta strong {
    padding: 0.25rem 0.625rem;
    border-radius: 1rem;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-xs);
  }

  .example-card h3 {
    margin: 0;
  }

  .card-lead {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .document-preview {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding: 1rem;
    border-inline-start: 0.25rem solid var(--color-accent);
    background: var(--color-bg-light);
  }

  .document-preview p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .document-preview .preview-label {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .document-preview p strong {
    display: block;
    color: var(--color-primary);
    font-size: var(--text-xs);
  }

  .showcase-note {
    margin: 1rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .card-link {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .example-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
