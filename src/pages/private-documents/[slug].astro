---
/**
 * 民間書件明細頁（委託書、授權書、切結書、聲明書）。
 *
 * 與 /cases/<slug>/ 同一個資料分工：全文與檢核結果取自 ods 應用 --llm 烘出來的
 * scenarios/*.json（真實產物），站台自己的欄位在 src/data/private-docs.js。
 *
 * ⚠️ 這一族群與 /citizens/ 的差別：那邊是「民眾對機關」與存證信函；
 * 這邊是立書人自己出具、載明事實並自承法律責任的文件。
 * 每一頁都要提醒「機關另有制式表格時以該機關的表格為準」——實搜這幾個字，
 * SERP 前排清一色是各機關自己的 .doc/.odt 制式表格，那才是使用者第一順位該拿的東西。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseDemo from '../../components/CaseDemo.astro';
import { SERVICE_LINKS } from '../../site.config.js';
import { PRIVATE_DOCS } from '../../data/private-docs.js';
import index from '../../data/scenarios.json';
import downloads from '../../data/downloads.json';

const payloads = import.meta.glob('../../data/scenarios/*.json', { eager: true });

export async function getStaticPaths() {
  const { PRIVATE_DOCS } = await import('../../data/private-docs.js');
  return PRIVATE_DOCS.map((d) => ({ params: { slug: d.slug }, props: { meta: d } }));
}

const { meta } = Astro.props;
const payload = payloads[`../../data/scenarios/${meta.key}.json`].default;
const listing = index.items.find((i) => i.key === meta.key);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const docType = payload.draft.doc_type;
const isSettlement = docType === '和解書';
const download = downloads.private?.[meta.slug] ?? null;
const blankTemplate = downloads.templates.find((t) => t.docType === docType) ?? null;
const failed = payload.checks.filter((c) => !c.ok);
const related = PRIVATE_DOCS.filter((d) => d.category === meta.category && d.slug !== meta.slug);
const others = PRIVATE_DOCS.filter((d) => d.category !== meta.category).slice(0, 2);

const description =
  `${meta.lead} 提供完整${docType}範例全文、${payload.checks.length} 條檢核結果與可自行編輯的 Word 檔。`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: pageUrl,
      headline: meta.seoTitle,
      description,
      author: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      publisher: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      inLanguage: 'zh-Hant-TW',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '民間書件', item: 'https://www.ods.yao.care/private-documents/' },
        { '@type': 'ListItem', position: 3, name: meta.seoTitle, item: pageUrl },
      ],
    },
  ],
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${meta.seoTitle}要寫哪些內容？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `這份文件的段落是${payload.draft.sections.map((s) => s.title).join('、')}。${meta.lead}`,
      },
    },
    {
      '@type': 'Question',
      name: `寫${docType}要注意什麼？`,
      acceptedAnswer: { '@type': 'Answer', text: `${meta.watchOut.join('；')}。` },
    },
    {
      '@type': 'Question',
      name: `${docType}一定要用這個格式嗎？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          `不一定。民間書件沒有法定強制格式，但受理的機關或對方常有自己的制式表格，` +
          `有的話以那份為準。本頁提供的是通用結構與可編輯的 Word 檔。`,
      },
    },
  ],
};
---

<BaseLayout schemas={[articleSchema, faq]} title={`${meta.seoTitle}｜公文 AI`} description={description}>
  <SiteHeader />
  <main id="main">
    <nav class="crumb" aria-label="麵包屑">
      <a href={`${base}private-documents/`}>民間書件</a> <span>/</span> <span>{meta.category}</span>
    </nav>

    <h1>{meta.seoTitle}</h1>
    <p class="lead">{meta.lead}</p>

    {isSettlement ? (
      <section class="danger">
        <h2 class="danger-title">簽之前先看這一段</h2>
        <p>
          民法第 737 條：<strong>和解有使當事人所拋棄之權利消滅的效力</strong>。
          簽下去之後要翻案，實務上是例外不是常態。
        </p>
        <p>
          臺灣新竹地方法院 110 年度簡上字第 111 號：一份<strong>新臺幣 3,000 元</strong>的和解書，
          因為「並無其他損害賠償請求權保留之陳述或記載」，
          關掉了當事人事後<strong>1,253 萬元</strong>的請求。
          那份和解書用的是流通的官方範本文字，其中一條是「乙方同意放棄民、刑事訴訟權益」。
        </p>
        <p>
          反過來，臺灣高等法院 108 年度上字第 904 號之所以讓受害人後續求償成立，
          關鍵是那份和解書載明<strong>「僅就系爭機車損害」</strong>——
          人身損害因此不在拋棄的射程內。
        </p>
        <ul>
          <li><strong>傷勢或損害還沒確定，就不要簽概括拋棄。</strong>把範圍寫窄，保留寫明。</li>
          <li>
            <strong>強制汽車責任保險不必先和解就能領。</strong>
            受害人可直接以書面通知對方的產險公司請求給付，不需加害人同意
            （強制汽車責任保險法第 7 條、第 34 條第 1 項第 2 款）。先簽和解等於把本來拿得到的錢當籌碼。
          </li>
          <li>
            <strong>有投保任意責任險的，和解前要書面通知保險公司參與。</strong>
            未經保險人參與或同意的和解，保險人可主張不受拘束（保險法第 93 條、
            強制汽車責任保險法第 30 條）。
          </li>
          <li>
            <strong>金額有爭議、對方是保險公司時，先別急著和解。</strong>
            金融消費者保護法第 24 條第 2 項：已成立和解或調解者，金融消費評議中心不受理。
          </li>
          <li>
            <strong>過失致死不是告訴乃論</strong>（刑法第 276 條），和解不會讓刑事案件消失，只影響量刑。
          </li>
        </ul>
        <p class="danger-note">
          有人受傷、金額較大、對方態度不明，或你不確定自己的傷勢會不會惡化 ——
          走<strong>鄉鎮市區調解委員會</strong>（免費，調解書經法院核定有執行力）或先諮詢律師，
          不要自己簽。本頁提供的是結構與用字參考，不是法律意見。
        </p>
      </section>
    ) : (
      <p class="caution">
        機關或對方另有制式表格時<strong>以那份為準</strong>。這類文件多半由受理單位自訂格式，
        先到該機關網站找有沒有；沒有再用這裡的通用結構。本頁內容為虛構案例，不代表法律意見。
      </p>
    )}

    <dl class="facts">
      <div><dt>文別</dt><dd>{docType}</dd></div>
      <div><dt>對象</dt><dd>{listing?.receiver ?? '無'}</dd></div>
      <div><dt>檢核</dt><dd>{payload.checks.length - failed.length}/{payload.checks.length} 通過</dd></div>
    </dl>

    <h2>試做這個範例</h2>
    <p class="note">流程與實際使用相同。範例內容可以看，改成自己的事情需要建立工作區。</p>
    <CaseDemo
      family="private"
      scenario={payload.scenario}
      draft={payload.draft}
      checks={payload.checks}
      receiver={listing?.receiver ?? null}
      download={download}
    />

    {download && (
      <>
        <h2>下載 Word 自己改</h2>
        <p class="note">
          民間書件沒有法定強制格式；這裡只沿用{downloads.source.name}的紙張、邊界與字級，
          讓下載檔看起來是一套。姓名、身分證統一編號、地址、電話與日期都是待填欄位。
        </p>
        <ul class="downloads">
          <li>
            <a href={`${base}downloads/${download.path}`} download={download.filename}>
              {meta.seoTitle}.docx
            </a>
            <span>含本頁全文，雙方資料與日期留空待填</span>
          </li>
          {blankTemplate && (
            <li>
              <a href={`${base}downloads/${blankTemplate.path}`} download={blankTemplate.filename}>
                {blankTemplate.filename}
              </a>
              <span>{blankTemplate.note}</span>
            </li>
          )}
        </ul>
      </>
    )}

    <h2>這種文件常踩的點</h2>
    <ul class="watch">
      {meta.watchOut.map((w) => <li>{w}</li>)}
    </ul>
    <p class="note">
      金額要寫成國字大寫的，對照表與換算在<a href={`${base}numbers/`}>數字大寫怎麼寫</a>；
      要寄給對方留證據的，看<a href={`${base}citizens/certified-letter-guide/`}>存證信函怎麼寄</a>。
    </p>

    {related.length > 0 && (
      <>
        <h2>同類文件</h2>
        <ul class="related">
          {related.map((r) => (
            <li><a href={`${base}private-documents/${r.slug}/`}>{r.seoTitle}</a></li>
          ))}
        </ul>
      </>
    )}

    {others.length > 0 && (
      <>
        <h2>其他民間書件</h2>
        <ul class="related">
          {others.map((r) => (
            <li><a href={`${base}private-documents/${r.slug}/`}>{r.seoTitle}</a></li>
          ))}
        </ul>
      </>
    )}

    <section class="cta-box">
      <h2>換成自己的事情試試</h2>
      <p>
        個人或企業可以直接建立工作區，把範例換成自己的事實與對象；
        產出會重新跑一次檢核，包含切結書與委託書那句責任文句在不在。
      </p>
      <div class="cta-row">
        <a class="primary" {...SERVICE_LINKS.selfRegister('private_self_register')}>建立個人工作區</a>
        <a class="secondary" href={`${base}private-documents/`}>看其他民間書件</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .crumb {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
  .crumb a {
    color: inherit;
  }
  h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
    margin-top: 0.5rem;
  }
  h2 {
    font-size: var(--text-xl);
    margin-top: 3rem;
  }
  .lead {
    font-size: var(--text-base);
    line-height: 1.9;
    color: var(--color-ink-soft);
    max-width: 46rem;
  }
  .danger {
    margin-block: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 2px solid var(--color-critical);
    border-radius: 0.375rem;
    background: var(--color-bg-light);
  }
  .danger-title {
    margin-top: 0;
    font-size: var(--text-lg);
    color: var(--color-critical);
  }
  .danger p,
  .danger li {
    font-size: var(--text-sm);
    line-height: 1.9;
  }
  .danger ul {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.25rem;
  }
  .danger-note {
    margin-bottom: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .caution {
    margin-block: 1.5rem;
    padding: 0.875rem 1.125rem;
    border-inline-start: 3px solid var(--color-warn);
    background: var(--color-bg-light);
    font-size: var(--text-sm);
    line-height: 1.9;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-block: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
  }
  .facts div {
    display: grid;
    gap: 0.25rem;
  }
  .facts dt {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
  }
  .downloads,
  .watch,
  .related {
    display: grid;
    gap: 0.75rem;
    padding-inline-start: 1.25rem;
  }
  .downloads {
    list-style: none;
    padding: 0;
  }
  .downloads li {
    display: grid;
    gap: 0.25rem;
  }
  .downloads span {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .watch li,
  .related li {
    font-size: var(--text-base);
    line-height: 1.9;
  }
  .note {
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-ink-soft);
  }
  .cta-box {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    background: var(--color-bg-light);
  }
  .cta-box h2 {
    margin-top: 0;
  }
  .cta-box p {
    font-size: var(--text-sm);
    line-height: 1.9;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .cta-row a {
    padding: 0.625rem 1.125rem;
    border-radius: 0.25rem;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .cta-row .primary {
    background: var(--color-primary);
    color: var(--color-bg);
  }
  .cta-row .secondary {
    border: 1px solid var(--color-line);
    color: var(--color-ink);
  }
</style>
