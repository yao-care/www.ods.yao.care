---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { CASES } from '../../data/cases.js';
import index from '../../data/scenarios.json';
import downloads from '../../data/downloads.json';
import { CITIZEN_EXAMPLES } from '../../data/citizen-examples.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const TYPES = [
  {
    name: '函',
    when: '機關之間往來、對民眾有所答復或請求，最常用的一種。',
    subject: '期望語看對象：對上級用「請鑒核」，平行機關用「請查照」，下級用「請查照辦理」。',
    keys: ['grant_report', 'subsidy_apply', 'repair', 'low_income'],
  },
  {
    name: '書函',
    when: '案情簡單、不需正式行文的答復或洽辦，比函輕。',
    subject: '結構與函相同，語氣較簡。常用在陳情案的初步回覆。',
    keys: ['petition_reply'],
  },
  {
    name: '公告',
    when: '對不特定多數人宣布事項，例如禁令、招標、時程。',
    subject: '沒有受文者。要把法源與罰則寫清楚，讓民眾看得懂。',
    keys: ['notice'],
  },
  {
    name: '簽',
    when: '對內陳報長官核示，不對外發文。',
    subject: '結尾用「簽請核示」或「陳請鑒核」，不用對外的期望語，也沒有受文者。',
    keys: ['sign'],
  },
  {
    name: '開會通知單',
    when: '召集會議，時間、地點、出席人員都有固定欄位。',
    subject: '主旨不要以「開會通知單：」開頭 —— 文別是另外的欄位，期望語仍用「請查照」。',
    keys: ['meeting'],
  },
];

// 民眾端的文別。機關公文選錯文別會退件，民眾書件選錯則是機關不知道該用哪個程序辦。
const CITIZEN_TYPES = [
  { name: '陳情書', when: '反映問題、請機關查明或處理，例如噪音、髒亂、道路破損。', subject: '寫可確認的事實與影響，不先替機關認定違法；請求事項要寫成希望機關採取的具體處理。' },
  { name: '申請書', when: '向機關申請某項資格、補助或許可。', subject: '申請事由、依據與檢附文件分開寫，機關才不必來電補問。' },
  { name: '申訴書', when: '對機關已經做出的處理結果有不同意見。', subject: '寫清楚原處分是哪一件、不同意的具體理由，以及請求重新查明什麼。' },
  { name: '說明書', when: '案件已經在辦，機關要求補充說明或補件。', subject: '把背景與補充資料整理成機關看得懂的段落，不要用口語敘述。' },
  { name: '存證信函', when: '個人或企業之間要留下正式通知紀錄，例如押金、借款、瑕疵退款、修繕、終止契約。', subject: '雙方姓名地址、事實經過、請求事項與履行期限都是必要欄位；用紙與字數格式由中華郵政規定。' },
];
const citizensOf = (docType) => CITIZEN_EXAMPLES.filter((e) => e.draft.doc_type === docType);

const caseOf = (key) => CASES.find((c) => c.key === key);
const docTypeOf = (key) => index.items.find((i) => i.key === key)?.doc_type ?? '';

// 文別指南是一篇文章，原本同樣缺 Article／麵包屑。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: pageUrl,
      headline: '公文文別怎麼選：函、書函、公告、簽、開會通知單',
      description: '五種常用文別的使用時機、主旨寫法與期望語差異，每一種都附完整範例。',
      author: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      publisher: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      inLanguage: 'zh-Hant-TW',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '文別', item: pageUrl },
      ],
    },
  ],
};
---

<ArticlePage
  schemas={[schema]}
  title="公文文別怎麼選：函、書函、公告、簽、開會通知單｜公文 AI"
  description="五種常用文別的使用時機、主旨寫法與期望語差異，每一種都附完整範例。"
  heading="文別怎麼選"
  lead="選錯文別，後面的期望語與段落結構都會跟著錯。這五種涵蓋地方機關日常九成以上的行文。"
>
  <p class="cross">
    稱謂語與期望語怎麼配對象、哪些字容易寫錯，查<a href={`${base}usage/`}>公文用語表</a>。
  </p>
  {TYPES.map((t) => (
    <section>
      <h2>{t.name}</h2>
      <p><strong>什麼時候用：</strong>{t.when}</p>
      <p><strong>主旨與期望語：</strong>{t.subject}</p>
      <ul>
        {t.keys.map((k) => {
          const c = caseOf(k);
          return c ? <li><a href={`${base}cases/${c.slug}/`}>{c.seoTitle}</a>（{docTypeOf(k)}）</li> : null;
        })}
      </ul>
    </section>
  ))}

  <section>
    <h2>民眾自己要寫的書件</h2>
    <p>
      公文不只存在於機關之間。向機關申請、陳情、申訴，或要正式通知另一個人與企業時，
      一樣有固定的段落與必填欄位。這五種涵蓋一般民眾會遇到的大部分情況。
    </p>
    {CITIZEN_TYPES.map((t) => (
      <section>
        <h3>{t.name}</h3>
        <p><strong>什麼時候用：</strong>{t.when}</p>
        <p><strong>寫法重點：</strong>{t.subject}</p>
        <ul>
          {citizensOf(t.name).map((e) => (
            <li><a href={`${base}citizens/${e.slug}/`}>{e.seoTitle}</a></li>
          ))}
        </ul>
      </section>
    ))}
    <p><a href={`${base}citizens/`}>看全部民眾書件與存證信函</a></p>
  </section>

  <section>
    <h2>空白範本下載</h2>
    <p>
      版面取自{downloads.source.name}（{downloads.source.promulgated}）的原始檔，
      欄位順序、字級、行距與縮排都照規範走：A4、四邊 2.5 公分邊界、中文標楷體、
      英數 Times New Roman，機關全銜與文別 20 點字、主旨與說明 16 點字、發文資訊 12 點字、頁碼 10 點字。
      下載後在 Word 直接改成自己的內容。
    </p>
    <ul class="templates">
      {downloads.templates.map((t) => (
        <li>
          <a href={`${base}downloads/${t.path}`} download={t.filename}>{t.filename}</a>
          <span>{t.note}</span>
        </li>
      ))}
    </ul>
    <p class="source">
      規範原文與 PDF／DOC／ODT 原始檔：
      <a href={downloads.source.page} rel="noopener">國家發展委員會檔案管理局</a>。
      存證信函用紙另依<a href={downloads.postalGuide} rel="noopener">中華郵政</a>規定，本站不重製用紙；
      費用、份數與交寄流程見<a href={`${base}citizens/certified-letter-guide/`}>存證信函怎麼寄</a>。
    </p>
  </section>

  <section>
    <h2>期望語對照</h2>
    <table>
      <thead><tr><th>行文對象</th><th>期望語</th></tr></thead>
      <tbody>
        <tr><td>上級機關</td><td>請鑒核、請核示</td></tr>
        <tr><td>平行機關</td><td>請查照</td></tr>
        <tr><td>下級機關</td><td>請查照辦理、請照辦</td></tr>
        <tr><td>對內陳核（簽）</td><td>簽請核示、陳請鑒核</td></tr>
      </tbody>
    </table>
    <p>依據見<a href={`${base}terms/`}>用語與法規速查</a>。</p>
  </section>
</ArticlePage>

<style>
  .templates {
    padding-inline-start: 0;
    list-style: none;
  }
  .templates li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .templates a {
    color: var(--color-primary);
  }
  .templates span {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
  .source {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
</style>
