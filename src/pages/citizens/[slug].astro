---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseDemo from '../../components/CaseDemo.astro';
import { SERVICE_LINKS } from '../../site.config.js';
import { CITIZEN_EXAMPLES } from '../../data/citizen-examples.js';
import downloads from '../../data/downloads.json';

export function getStaticPaths() {
  return CITIZEN_EXAMPLES.map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const failed = example.checks.filter((check) => !check.ok);
const familyLabel = example.family === 'notice' ? '個人／企業之間' : '民眾對機關';
const description = `${example.lead} 提供完整${example.draft.doc_type}示範、民眾文件檢核流程與可自行編輯的 Word 檔。`;
const download = downloads.citizens[example.slug] ?? null;
const isNotice = example.family === 'notice';
const blankTemplate = downloads.templates.find((t) => t.docType === example.draft.doc_type) ?? null;

// 同族群的其他文件。民眾端明細頁原本只有 /citizens/ 一個入口連進來，
// Google 只從 sitemap 發現、遲遲不爬（2026-08-19 實測 8/10 頁未爬），所以補上橫向互連。
const sameFamily = CITIZEN_EXAMPLES.filter((e) => e.family === example.family && e.slug !== example.slug);
const otherFamily = CITIZEN_EXAMPLES.filter((e) => e.family !== example.family).slice(0, 2);
const familyLabelOf = (e) => (e.family === 'notice' ? '存證信函' : '民眾對機關');

// 民眾端明細頁原本一條單頁結構化資料都沒有（只有 BaseLayout 給的 Organization／WebSite），
// 機關端的 /cases/<slug>/ 早就有 Article＋麵包屑＋FAQ。這是 2026-08-19 內鏈修完之後，
// 民眾端仍卡在 Discovered 未收錄的第二個結構性差異，兩邊待遇一致才比得出內容本身的差異。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: pageUrl,
      headline: example.seoTitle,
      description,
      author: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      publisher: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      inLanguage: 'zh-Hant-TW',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '民眾文件', item: 'https://www.ods.yao.care/citizens/' },
        { '@type': 'ListItem', position: 3, name: example.seoTitle, item: pageUrl },
      ],
    },
  ],
};

// seoTitle 是「存證信函範例｜通知返還租賃押金」這種兩段式，整串接進問句會變成
// 「存證信函範例｜通知返還租賃押金要寫成哪一種文件？」。取後半段當主題才像人會問的話。
const topic = example.seoTitle.split('｜').pop();

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${topic}要寫成哪一種文件？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `這種情況寫「${example.draft.doc_type}」。${example.lead}`,
      },
    },
    {
      '@type': 'Question',
      name: `${topic}的${example.draft.doc_type}要注意什麼？`,
      acceptedAnswer: { '@type': 'Answer', text: example.watchOut.join('；') + '。' },
    },
    ...(isNotice
      ? [
          {
            '@type': 'Question',
            name: '存證信函可以自己印用紙嗎？',
            acceptedAnswer: {
              '@type': 'Answer',
              text:
                '不行。中華郵政規定存證信函「請依所提供之格式使用，變更樣式內容者，不予收寄」，' +
                '用紙要用郵局提供的格式。這裡只產生內文，並照官方使用說明設定英數符號全形、字體 18、' +
                '段落固定行高 34pt 靠左對齊、字元間距 2.9pt，貼進官方用紙就會落在格子內。',
            },
          },
        ]
      : []),
  ],
};
---

<BaseLayout
  title={`${example.seoTitle}｜公文 AI`}
  description={description}
>
  <SiteHeader />
  <main>
    <nav class="crumb" aria-label="麵包屑">
      <a href={`${base}citizens/`}>民眾文件</a> <span>/</span> <span>{example.category}</span>
    </nav>

    <h1>{example.seoTitle}</h1>
    <p class="lead">{example.lead}</p>

    <dl class="facts">
      <div><dt>文件族群</dt><dd>{familyLabel}</dd></div>
      <div><dt>文別</dt><dd>{example.draft.doc_type}</dd></div>
      <div><dt>文件檢核</dt><dd>{example.checks.length - failed.length}/{example.checks.length} 通過</dd></div>
    </dl>

    <h2>試做這個文件</h2>
    <p class="note">
      流程與實際使用相同：先看範例內容，再產生草稿、查看檢核結果；改成自己的資料或匯出文件需要工作區。
    </p>
    <CaseDemo
      family={example.family}
      scenario={example.scenario}
      draft={example.draft}
      checks={example.checks}
      receiver={example.draft.fields?.receiver ?? null}
      download={download}
    />

    {download && (
      <>
        <h2>下載 Word 自己改</h2>
        {isNotice ? (
          <p class="note">
            存證信函的用紙由中華郵政規定，且明文「請依所提供之格式使用，變更樣式內容者，不予收寄」，
            所以這裡不重製用紙，只把內文照官方使用說明設定好：英數符號全形、字體 18、
            段落固定行高 34pt 靠左對齊、字元間距加寬 2.9pt。下載後複製貼進官方用紙，字就會落在格子內。
          </p>
        ) : (
          <p class="note">
            版面沿用{downloads.source.name}的紙張、邊界、字級與縮排，機關收到時的閱讀感受與內部公文一致。
            姓名、地址、電話與日期留空待填。
          </p>
        )}
        <ul class="downloads">
          <li>
            <a href={`${base}downloads/${download.path}`} download={download.filename}>
              {download.filename}
            </a>
            <span>含本頁全文</span>
          </li>
          {blankTemplate && (
            <li>
              <a href={`${base}downloads/${blankTemplate.path}`} download={blankTemplate.filename}>
                {blankTemplate.filename}
              </a>
              <span>{blankTemplate.note}</span>
            </li>
          )}
          {isNotice && (
            <li>
              <a href={downloads.postalGuide} rel="noopener">中華郵政存證信函官方用紙</a>
              <span>用紙、使用說明與網路交寄說明都在這一頁（外部連結）</span>
            </li>
          )}
        </ul>
      </>
    )}

    <h2>這類文件常注意的點</h2>
    <ul class="watch">
      {example.watchOut.map((item) => <li>{item}</li>)}
    </ul>
    <p class="note">
      民眾文件會依文件族群檢查主旨、段落、請求事項、個資與必要欄位；不會套用機關公文的期望語或簽核規則。
    </p>

    {sameFamily.length > 0 && (
      <>
        <h2>{isNotice ? '其他存證信函範例' : '其他民眾書件範例'}</h2>
        <ul class="related">
          {sameFamily.map((e) => (
            <li>
              <a href={`${base}citizens/${e.slug}/`}>{e.seoTitle}</a>
              <span>{e.lead}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {otherFamily.length > 0 && (
      <>
        <h2>{isNotice ? '要寫給機關的話' : '要通知個人或企業的話'}</h2>
        <ul class="related">
          {otherFamily.map((e) => (
            <li>
              <a href={`${base}citizens/${e.slug}/`}>{e.seoTitle}</a>
              <span>{familyLabelOf(e)}</span>
            </li>
          ))}
          <li>
            <a href={`${base}cases/`}>機關端的公文範例庫</a>
            <span>函、公告、開會通知單、簽 —— 機關承辦寫的那一邊</span>
          </li>
        </ul>
      </>
    )}

    <section class="cta-box">
      <h2>用自己的事情開始</h2>
      <p>
        建立個人工作區後，可以選擇申請書、陳情書、申訴書、說明書或存證信函，填入自己的事實與必要欄位，
        再查看檢核結果並匯出純文字或 Word 文件。
      </p>
      <div class="cta-row">
        <a class="primary" href={SERVICE_LINKS.selfRegister(`citizens_${example.slug}_register`)}>建立個人工作區</a>
        <a class="secondary" href={`${base}citizens/`}>回到民眾文件</a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .crumb {
    margin-bottom: 1rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .crumb a {
    color: var(--color-primary);
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: var(--text-xl);
  }

  .lead {
    max-width: 46rem;
    margin-top: 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    line-height: 1.9;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 1.5rem 0 0;
    padding: 1rem 0;
    border-block: 1px solid var(--color-line);
  }

  .facts dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .related {
    display: grid;
    gap: 0.75rem;
    padding-inline-start: 0;
    list-style: none;
  }

  .related li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .related a {
    color: var(--color-primary);
    font-size: var(--text-base);
  }

  .related span {
    flex: 1 1 18rem;
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .downloads {
    display: grid;
    gap: 0.75rem;
    padding-inline-start: 0;
    list-style: none;
  }

  .downloads li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .downloads a {
    color: var(--color-primary);
    font-size: var(--text-base);
  }

  .downloads span {
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .note {
    margin-bottom: 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .watch {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.5rem;
  }

  .watch li {
    font-size: var(--text-base);
    line-height: 1.8;
  }

  .cta-box {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 0.5rem;
    background: var(--color-bg-light);
  }

  .cta-box h2 {
    margin-top: 0;
  }

  .cta-box p {
    margin-bottom: 1.5rem;
    font-size: var(--text-base);
    line-height: 1.9;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .primary {
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    background: var(--color-accent);
    color: var(--color-white);
    font-size: var(--text-base);
    text-decoration: none;
  }

  .primary:hover {
    background: var(--color-accent-dark);
  }

  .secondary {
    color: var(--color-primary);
    font-size: var(--text-sm);
  }
</style>
