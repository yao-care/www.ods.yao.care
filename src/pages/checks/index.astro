---
import ArticlePage from '../../layouts/ArticlePage.astro';
import PageToc from '../../components/PageToc.astro';
import sample from '../../data/scenarios/grant_report.json';
import meetingSample from '../../data/scenarios/meeting.json';
import noticeSample from '../../data/scenarios/notice.json';
import { PRIVATE_DOCS } from '../../data/private-docs.js';
import { CITIZEN_EXAMPLES } from '../../data/citizen-examples.js';
import downloads from '../../data/downloads.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 檢核清單直接取自實際產物，不手抄 —— 產品改版時這頁會跟著變
const checks = sample.checks;

const GROUPS = [
  {
    id: 'subject',
    name: '主旨',
    ids: ['subject_present', 'subject_single_paragraph', 'subject_length', 'subject_expectation', 'subject_period', 'subject_no_section_name'],
    why: '主旨要一段到底、句末帶期望語。分項或漏期望語是最常見的退件原因。',
  },
  {
    id: 'sections',
    name: '文別與段落',
    ids: ['doc_type_valid', 'classification_valid', 'section_titles_valid', 'section_not_empty', 'section_item_period', 'section_item_count', 'section_item_length'],
    why: '說明、辦法的段名與分項寫法有固定規矩，一項只講一件事。',
  },
  {
    id: 'privacy',
    name: '個資與代稱',
    ids: ['no_mask_token', 'no_placeholder', 'no_raw_id_number', 'no_raw_mobile'],
    why: '去識別化的代稱如果殘留在稿件裡，或身分證號、手機號直接寫進公文，都不能送出。',
  },
  {
    id: 'wording',
    name: '用字與格式',
    ids: ['roc_year', 'currency_format', 'no_colloquial', 'no_simplified', 'fullwidth_punctuation', 'no_extra_blank'],
    why: '民國紀年、國字大寫金額、全形標點、無簡體字 —— 這幾條機器抓比人快。',
  },
  {
    id: 'receiver',
    name: '收發',
    ids: ['receiver_required'],
    why: '函必須有受文者；簽與公告則沒有。',
  },
];

const byId = Object.fromEntries(checks.map((c) => [c.id, c]));
const grouped = GROUPS.map((g) => ({ ...g, items: g.ids.map((id) => byId[id]).filter(Boolean) }));
const covered = new Set(GROUPS.flatMap((g) => g.ids));
const others = checks.filter((c) => !covered.has(c.id));

// 條目數一律取實際產物的長度（`checks.length`），不寫死 —— 檢核規則改版時這頁跟著變，
// 而且開會通知單另有一組（`meetingSample.checks.length`），寫死會兩邊打架。
const count = checks.length;
const meetingCount = meetingSample.checks.length;
const noticeCount = noticeSample.checks.length;
// 公告少掉的那幾條（目前是主旨期望語），一樣用實際產物比對算出來，不寫死。
const noticeIds = new Set(noticeSample.checks.map((c) => c.id));
const notForNotice = checks.filter((c) => !noticeIds.has(c.id));

// 民間書件（private 族群）另有一組：拿掉「請求事項必填」，另加這個族群才有的幾條。
// 一樣用實際產物比對算出來，不寫死——規則改了這頁跟著變。
// 「這個文別才有的」要同時排除機關公文與民眾書件那兩組 —— 只拿公文當基準的話，
// sender_required（發文人必填）會被誤認成民間書件專屬，但民眾書件也有那一條。
const sharedIds = new Set([
  ...checks.map((c) => c.id),
  ...(CITIZEN_EXAMPLES[0]?.checks ?? []).map((c) => c.id),
]);
const privatePayloads = import.meta.glob('../../data/scenarios/*.json', { eager: true });
// 每一種民間書件的條目數與專屬檢核，都取實際烘出來的產物，不寫死。
const privateByType = new Map();
for (const d of PRIVATE_DOCS) {
  const payload = privatePayloads[`../../data/scenarios/${d.key}.json`]?.default;
  if (!payload) continue;
  const docType = payload.draft.doc_type;
  if (privateByType.has(docType)) continue;
  privateByType.set(docType, {
    docType,
    count: payload.checks.length,
    own: payload.checks.filter((c) => !sharedIds.has(c.id)),
  });
}
const privateRows = [...privateByType.values()];
const privateMin = Math.min(...privateRows.map((r) => r.count));
const privateMax = Math.max(...privateRows.map((r) => r.count));
const meetingOwn = meetingSample.checks.filter((c) => c.id.startsWith('meeting_'));
const subjectCount = GROUPS.find((g) => g.id === 'subject').ids.length;
const sectionCount = GROUPS.find((g) => g.id === 'sections').ids.length;

const title = `公文格式檢核 ${count} 條`;
const description =
  `主旨、段落、個資代稱、用字格式、收發共 ${count} 條公文格式檢核，逐條說明為什麼會被退件。`;

// 章節的單一真實來源；錨點由 scripts/check-anchors.mjs 守門。
const S = {
  ...Object.fromEntries(
    grouped.map((g) => [g.id, { id: g.id, label: `${g.name}（${g.items.length} 條）` }]),
  ),
  ...(others.length ? { others: { id: 'others', label: '其他' } } : {}),
  notice: { id: 'notice', label: `公告少一條（${noticeCount} 條）` },
  private: { id: 'private-family', label: `民間書件另有一組（${privateMin}～${privateMax} 條，依文別而定）` },
  meeting: { id: 'meeting', label: `開會通知單另有一組（${meetingCount} 條）` },
  live: { id: 'live', label: '看實際跑出來的結果' },
};

// 這頁是一篇說明檢核條目的參考文章，但原本沒有 Article／麵包屑，
// Google 只看得到全站共用的 Organization／WebSite。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: pageUrl,
      headline: title,
      description,
      author: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      publisher: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      inLanguage: 'zh-Hant-TW',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '格式檢核', item: pageUrl },
      ],
    },
  ],
};

// 這頁原本沒有 FAQPage —— 但「公文為什麼被退件」「主旨可以分項嗎」這類問句查詢
// 的落點就是這頁，樞紐頁不掛 FAQ 等於把問句型結果讓給別人。
const faqPairs = [
  {
    q: '公文格式檢核會檢查哪些項目？',
    a: `函、書函、簽共 ${count} 條，分成主旨（${subjectCount} 條）、文別與段落（${sectionCount} 條）、`
      + `個資與代稱、用字與格式、收發五組。公告 ${noticeCount} 條（不套主旨期望語那條）；`
      + `民間書件（委託書、切結書、和解書等）另有一組 ${privateMin}～${privateMax} 條，依文別而定；`
      + '開會通知單是固定欄位表單，不套主旨與段落那兩組，'
      + `改查它自己的欄位，合計 ${meetingCount} 條。`,
  },
  {
    q: '公文主旨可以分項嗎？',
    a: '不行。主旨要一段到底、不分項，文字緊接段名冒號之右書寫，句末帶概括的期望語。'
      + '需要分項敘述的事實、理由或作法，放到說明段或辦法段。',
  },
  {
    q: '公文裡出現簡體字會怎樣？',
    a: '簡體字屬於不通過就不得送簽的等級。檢核用的是逐字比對的簡體專用字集合，'
      + '刻意放行「后、里、面、台、出、合、同」這類本身就是正體字、只是同時也是別字簡化形的雙身分字，'
      + '以免在合法公文上誤報。',
  },
  {
    q: '身分證號或手機號可以直接寫進公文嗎？',
    a: '不行，檢核會擋。稿件送進模型前先做去識別化，代稱如果殘留在成稿裡同樣不得送出。'
      + '對民眾的處分或通知，用代稱加上案號辨識即可。',
  },
  {
    q: '金額和年份要怎麼寫？',
    a: '年份用民國紀年，金額依公文書橫式書寫數字使用原則處理；'
      + '屬於防竄改需求的款項另以國字大寫書寫。這幾條機器抓得比人快，逐條結果在每一則公文範例上看得到。',
  },
];
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPairs.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
---

<ArticlePage
  schemas={[schema, faq]}
  title={`${title}｜公文 AI`}
  description={description}
  heading={`格式檢核 ${count} 條`}
  lead={`每一份草稿產出後都會跑這 ${count} 條。critical 等級不通過就不讓送簽，warn 等級會標出來讓承辦自己判斷。`}
>
  <p class="cross">
    這裡檢查的是格式。三段怎麼分看<a href={`${base}writing/`}>公文怎麼寫</a>，
    用字與稱謂語查<a href={`${base}usage/`}>公文用語表</a>。
  </p>
  <PageToc items={Object.values(S)} />

  {grouped.map((g) => (
    <section>
      <h2 id={g.id}>{g.name}（{g.items.length} 條）</h2>
      <p>{g.why}</p>
      <table>
        <thead>
          <tr><th>檢核項目</th><th>等級</th></tr>
        </thead>
        <tbody>
          {g.items.map((c) => (
            <tr>
              <td>{c.title}</td>
              <td class={c.severity === 'critical' ? 'critical' : 'warn'}>
                {c.severity === 'critical' ? '不通過不得送簽' : '提醒'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  {others.length > 0 && (
    <section>
      <h2 id={S.others.id}>其他</h2>
      <ul>{others.map((c) => <li>{c.title}</li>)}</ul>
    </section>
  )}

  <section>
    <h2 id={S.notice.id}>公告少一條（{noticeCount} 條）</h2>
    <p>
      公告不跑{notForNotice.map((c) => `「${c.title}」`).join('、')}。
      手冊對公告只要求主旨「扼要敘述公告之目的及要求」，沒有要求期望語；
      手冊附錄 6 的兩則公告作法舉例，主旨也都沒有期望語 ——
      像「主旨：公告民國00年出生的役男應辦理身家調查。」就是官方範例本身。
    </p>
    <p class="note">
      道理上也對得起來：期望語是對受文者說的話，而公告對不特定多數人、沒有受文者。
      把這條套在公告上，手冊自己的範例會被判成不合格。
    </p>
  </section>

  <section>
    <h2 id={S.private.id}>民間書件另有一組（{privateMin}～{privateMax} 條，依文別而定）</h2>
    <p>
      委託書、授權書、切結書、聲明書、和解書不是公文，
      套的是<a href={`${base}private-documents/`}>民間書件</a>那一組檢核：
      拿掉「請求事項必填」（這幾種文件沒有那一段），另外加上這個族群才有的幾條 ——
      而且<strong>只在適用的文別上才列出來</strong>，不適用的不會湊數。
    </p>
    <table>
      <thead><tr><th>文別</th><th>條數</th><th>這個文別才有的</th></tr></thead>
      <tbody>
        {privateRows.map((r) => (
          <tr>
            <td>{r.docType}</td>
            <td>{r.count}</td>
            <td class="when">{r.own.length ? r.own.map((c) => c.title).join('、') : '（無）'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      「責任文句」擋的是<strong>會被退件</strong>，不是「法律上不成立」——
      不實陳述的責任來自刑法第 214 條與行政程序法第 119 條第 2 款，不是那句話創設的；
      但它在許多作用法規裡是應記載字樣（土地登記規則第 97 條把該句寫進條文）。
      「特別授權事項」對應民法第 534 條的六類行為；
      「拋棄範圍」與「強制險」對應民法第 737 條與強制汽車責任保險法。
    </p>
  </section>

  <section>
    <h2 id={S.meeting.id}>開會通知單另有一組（{meetingCount} 條）</h2>
    <p>
      這 {count} 條是「函」的檢核。開會通知單依<a href={downloads.source.page} rel="noopener">{downloads.source.name}</a>
      第八點是固定欄位表單 —— 沒有主旨、沒有說明或辦法 —— 所以上面的 {subjectCount} 條主旨檢核與
      {sectionCount} 條段落檢核對它不適用，改查它自己的欄位。
    </p>
    <table>
      <thead><tr><th>檢核項目</th><th>等級</th></tr></thead>
      <tbody>
        {meetingOwn.map((c) => (
            <tr>
              <td>{c.title}</td>
              <td class={c.severity === 'critical' ? 'critical' : 'warn'}>
                {c.severity === 'critical' ? '不通過不得送簽' : '提醒'}
              </td>
            </tr>
        ))}
      </tbody>
    </table>
    <p class="note">
      其餘 {meetingCount - meetingOwn.length} 條通用文字檢核（個資殘留、簡體字、民國紀年、全形標點…）
      兩邊都跑，合計 {meetingCount} 條。
    </p>
  </section>

  <section>
    <h2 id={S.live.id}>看實際跑出來的結果</h2>
    <p>
      每一則<a href={`${base}cases/`}>公文範例</a>都附了逐條結果，可以直接看哪些通過、哪些被標記。
      開會通知單那則跑的是上面那組 {meetingCount} 條，公告那幾則是 {noticeCount} 條，
      <a href={`${base}private-documents/`}>民間書件</a>那幾則依文別而定，{privateMin}～{privateMax} 條。
    </p>
  </section>
</ArticlePage>

<style>
  .when {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .critical {
    color: var(--color-critical);
  }
  .warn {
    color: var(--color-warn);
  }
</style>
