---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { SERVICE_LINKS } from '../../site.config.js';
import { ORGANIZATION, breadcrumb, faqPage } from '../../data/schema.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 採購與資安審查會直接問這幾題，做成 FAQPage 讓它們在搜尋結果與 AI 回答裡是可引用的單元。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: pageUrl,
      headline: '公文 AI 的資料處理方式',
      description:
        '稿件送到模型之前先做去識別化，遮罩對照表存在機關自己的資料庫並於 24 小時內刪除，' +
        '各工作區資料實體隔離，登入到匯出全程留稽核軌跡。',
      author: ORGANIZATION,
      publisher: ORGANIZATION,
      inLanguage: 'zh-Hant-TW',
    },
    breadcrumb([['資料處理方式', pageUrl]]),
  ],
};

const faq = faqPage([
  [
    '公文原文會被送到語言模型嗎？',
    '不會。姓名、身分證號、電話、地址在送出前會換成代稱，模型看到的是代稱，產出後系統再還原成真名。' +
      '呼叫模型的介面在型別上只接受已遮罩的文字，傳入未遮罩的字串會直接失敗，沒有繞過去的路徑。',
  ],
  [
    '去識別化服務不可用的時候會怎麼處理？',
    '系統改用本機規則引擎組稿，完全在機關的機器上完成，一個字都不外傳，並把產出標記為降級。' +
      '語料批次匯入遇到同樣狀況會整批標記失敗並通知管理者，不會退回用正則表示式充數。',
  ],
  [
    '遮罩對照表放在哪裡、留多久？',
    '存在該機關自己的資料庫，不集中在共用服務上，並於 24 小時內由系統排程刪除；' +
      '去識別化服務本身處理完就把對照交還呼叫端，自己不保存。',
  ],
  [
    '不同機關的資料怎麼隔離？',
    '每個機關或個人工作區有自己的資料庫檔案與檔案目錄，不是同一張表用欄位區隔；' +
      '跨工作區存取在檔案路徑層被擋下。服務方的營運後台只看得到租戶名冊與用量統計，看不到公文內容。',
  ],
  [
    '有稽核軌跡嗎？',
    '登入、產生、檢核、簽核、匯出、語料上架都會留下軌跡，記在該機關自己的資料庫裡，需要時可以整包匯出，包含資料字典。',
  ],
]);
---

<ArticlePage
  schemas={[schema, faq]}
  title="資料處理方式：去識別化與資料落地｜公文 AI"
  description="稿件送到模型之前先做去識別化，遮罩對照表存在機關自己的資料庫並於 24 小時內刪除，各機關資料實體隔離。"
  heading="資料處理方式"
  lead="採購審查一定會問這幾件事，先寫在這裡。"
>
  <section>
    <h2>送出去的不是原文</h2>
    <p>
      稿件在送到語言模型之前，姓名、身分證號、電話、地址會先換成代稱 ——
      「陳美玲」變成「A君」、身分證號變成「【身分證A】」。模型看到的是代稱，產出後系統再還原成真名。
    </p>
    <p>
      這不是靠承辦記得先按遮罩鈕。呼叫模型的介面在型別上就只接受「已遮罩」的文字，
      傳入未遮罩的字串會直接失敗，沒有繞過去的路徑。
    </p>
  </section>

  <section>
    <h2>去識別化失敗的時候，不送出</h2>
    <p>
      遮罩服務不可用時，系統改用本機規則引擎組稿 —— 完全在機關的機器上完成，一個字都不外傳。
      產出會標記為降級，讓承辦知道這份的品質與平常不同。
    </p>
    <p>
      語料批次匯入遇到同樣狀況會整批標記失敗並通知管理者，不會退回用正則表示式充數。
      正則抓不到「陳美玲女士」這種沒有格式特徵的姓名，用它充數等於讓未遮罩的真名進入知識庫。
    </p>
  </section>

  <section>
    <h2>遮罩對照表放哪裡、留多久</h2>
    <p>
      代稱與真名的對照表存在該機關自己的資料庫，不集中在共用服務上，並於 24 小時內由系統排程刪除。
      去識別化服務本身不保存任何對照表 —— 它處理完就把對照交還呼叫端，自己不留。
    </p>
  </section>

  <section>
    <h2>民眾文件的寄收欄位</h2>
    <p>
      民眾對機關書件與存證信函會另外填寫寄件人、收件人、地址、聯絡方式、期限與附件。
      這些結構化欄位留在自己的工作區，只用於本機預覽、格式檢核與純文字／Word 匯出，
      不會直接放進模型提示；事實敘述仍須先經過去識別化。
    </p>
    <p>
      民眾文件若沒有可用的真實去識別化服務，系統會改用本機規則引擎，不把原文送往模型，
      並在草稿上標示降級狀態。
    </p>
  </section>

  <section>
    <h2>工作區之間的隔離</h2>
    <p>
      每個機關或個人工作區有自己的資料庫檔案與檔案目錄，不是同一張表用欄位區隔。
      跨工作區存取在檔案路徑層被擋下，不依賴應用層記得加條件。
      服務方的營運後台只看得到租戶名冊與用量統計，看不到任何公文內容。
    </p>
  </section>

  <section>
    <h2>稽核軌跡</h2>
    <p>
      登入、產生、檢核、簽核、匯出、語料上架都會留下軌跡，記在該機關自己的資料庫裡。
      需要時可以整包匯出，包含資料字典。
    </p>
  </section>

  <section>
    <h2>還有什麼要問的</h2>
    <p>
      採購或資安審查需要更細的說明文件，<a {...SERVICE_LINKS.agencyApply('security_agency_apply')}>來信告訴我們</a>，
      會依貴機關的檢核表逐項回覆。
    </p>
  </section>
</ArticlePage>
