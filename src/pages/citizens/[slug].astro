---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseDemo from '../../components/CaseDemo.astro';
import { SERVICE_LINKS } from '../../site.config.js';
import { CITIZEN_EXAMPLES } from '../../data/citizen-examples.js';

export function getStaticPaths() {
  return CITIZEN_EXAMPLES.map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const failed = example.checks.filter((check) => !check.ok);
const familyLabel = example.family === 'notice' ? '個人／企業之間' : '民眾對機關';
const description = `${example.lead} 提供完整${example.draft.doc_type}示範與民眾文件檢核流程。`;
---

<BaseLayout
  title={`${example.seoTitle}｜公文 AI`}
  description={description}
>
  <SiteHeader />
  <main>
    <nav class="crumb" aria-label="麵包屑">
      <a href={`${base}citizens/`}>民眾文件</a> <span>/</span> <span>{example.category}</span>
    </nav>

    <h1>{example.seoTitle}</h1>
    <p class="lead">{example.lead}</p>

    <dl class="facts">
      <div><dt>文件族群</dt><dd>{familyLabel}</dd></div>
      <div><dt>文別</dt><dd>{example.draft.doc_type}</dd></div>
      <div><dt>文件檢核</dt><dd>{example.checks.length - failed.length}/{example.checks.length} 通過</dd></div>
    </dl>

    <h2>試做這個文件</h2>
    <p class="note">
      流程與實際使用相同：先看範例內容，再產生草稿、查看檢核結果；改成自己的資料或匯出文件需要工作區。
    </p>
    <CaseDemo
      family={example.family}
      scenario={example.scenario}
      draft={example.draft}
      checks={example.checks}
      receiver={example.draft.fields?.receiver ?? null}
    />

    <h2>這類文件常注意的點</h2>
    <ul class="watch">
      {example.watchOut.map((item) => <li>{item}</li>)}
    </ul>
    <p class="note">
      民眾文件會依文件族群檢查主旨、段落、請求事項、個資與必要欄位；不會套用機關公文的期望語或簽核規則。
    </p>

    <section class="cta-box">
      <h2>用自己的事情開始</h2>
      <p>
        建立個人工作區後，可以選擇申請書、陳情書、申訴書、說明書或存證信函，填入自己的事實與必要欄位，
        再查看檢核結果並匯出純文字或 Word 文件。
      </p>
      <div class="cta-row">
        <a class="primary" href={SERVICE_LINKS.selfRegister(`citizens_${example.slug}_register`)}>建立個人工作區</a>
        <a class="secondary" href={`${base}citizens/`}>回到民眾文件</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .crumb {
    margin-bottom: 1rem;
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .crumb a {
    color: var(--color-primary);
  }

  h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: var(--text-xl);
  }

  .lead {
    max-width: 46rem;
    margin-top: 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    line-height: 1.9;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 1.5rem 0 0;
    padding: 1rem 0;
    border-block: 1px solid var(--color-line);
  }

  .facts dt {
    color: var(--color-ink-muted);
    font-size: var(--text-xs);
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .note {
    margin-bottom: 1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .watch {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.5rem;
  }

  .watch li {
    font-size: var(--text-base);
    line-height: 1.8;
  }

  .cta-box {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 0.5rem;
    background: var(--color-bg-light);
  }

  .cta-box h2 {
    margin-top: 0;
  }

  .cta-box p {
    margin-bottom: 1.5rem;
    font-size: var(--text-base);
    line-height: 1.9;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .primary {
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    background: var(--color-accent);
    color: var(--color-white);
    font-size: var(--text-base);
    text-decoration: none;
  }

  .primary:hover {
    background: var(--color-accent-dark);
  }

  .secondary {
    color: var(--color-primary);
    font-size: var(--text-sm);
  }
</style>
