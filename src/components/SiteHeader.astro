---
import { SERVICE_LINKS } from '../site.config.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname;
const nav = [
  { href: `${base}cases/`, label: '公文範例' },
  { href: `${base}checks/`, label: '格式檢核' },
  { href: `${base}doc-types/`, label: '文別' },
  { href: `${base}terms/`, label: '用語與法規' },
  { href: `${base}product/`, label: '功能' },
  { href: `${base}security/`, label: '資料處理' },
];
---

<header>
  <div class="bar">
    <a class="brand" href={base}>公文 AI</a>
    <nav aria-label="主導覽">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a class="cta" href={SERVICE_LINKS.agencyApply('header_apply')}>申請試用</a>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
  }
  .bar {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-inline-end: auto;
  }
  nav a {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }
  .cta {
    font-size: var(--text-sm);
    background: var(--color-accent);
    color: var(--color-white);
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    text-decoration: none;
  }
  .cta:hover {
    background: var(--color-accent-dark);
  }
</style>
