  "templates": [
    {
      "slug": "official-letter",
      "label": "函",
      "docType": "函",
      "note": "對上級用「請鑒核」，對平行或下級用「請查照」，期望語寫在主旨句末。",
      "path": "templates/official-letter.docx",
      "filename": "函空白範本.docx"
    },
    {
      "slug": "official-memo",
      "label": "書函",
      "docType": "書函",
      "note": "規範第六點：書函比照函辦理，用於洽詢、答復或不需正式行文的案件。",
      "path": "templates/official-memo.docx",
      "filename": "書函空白範本.docx"
    },
    {
      "slug": "public-notice",
      "label": "公告",
      "docType": "公告",
      "note": "公告沒有受文者，印信蓋於發文字號與公告內容之間右方，段名為主旨、依據、公告事項。",
      "path": "templates/public-notice.docx",
      "filename": "公告空白範本.docx"
    },
    {
      "slug": "meeting-notice",
      "label": "開會通知單",
      "docType": "開會通知單",
      "note": "開會事由、時間、地點、主持人、聯絡人及電話是固定欄位，不要塞進主旨。",
      "path": "templates/meeting-notice.docx",
      "filename": "開會通知單空白範本.docx"
    },
    {
      "slug": "internal-sign",
      "label": "簽",
      "docType": "簽",
      "note": "簽是對內文書，段名為主旨、說明、擬辦，結尾用「簽請核示」或「簽請鑒核」。",
      "path": "templates/internal-sign.docx",
      "filename": "簽空白範本.docx"
    },
    {
      "slug": "citizen-petition",
      "label": "陳情書",
      "docType": "陳情書",
      "note": "民眾對機關的書件，段名為事實與理由、請求事項、附件。",
      "path": "templates/citizen-petition.docx",
      "filename": "陳情書空白範本.docx"
    },
    {
      "slug": "citizen-application",
      "label": "申請書",
      "docType": "申請書",
      "note": "申請事由、依據與檢附文件分開寫，機關才不必來電補問。",
      "path": "templates/citizen-application.docx",
      "filename": "申請書空白範本.docx"
    },
    {
      "slug": "private-poa",
      "label": "委託書",
      "docType": "委託書",
      "note": "委託事項要具體到承辦看得懂能不能受理；結尾要有「如有虛偽不實，本人願負相關法律責任」。",
      "path": "templates/private-poa.docx",
      "filename": "委託書空白範本.docx"
    },
    {
      "slug": "private-authorization",
      "label": "授權書",
      "docType": "授權書",
      "note": "授權範圍要寫清楚「不含什麼」，否則對方可以做的事會比你想的多。",
      "path": "templates/private-authorization.docx",
      "filename": "授權書空白範本.docx"
    },
    {
      "slug": "private-affidavit",
      "label": "切結書",
      "docType": "切結書",
      "note": "「如有不實，願負法律責任」多數機關列為應記載字樣，缺了會被退件。機關多半有自己的制式切結書，有就用那一份。",
      "path": "templates/private-affidavit.docx",
      "filename": "切結書空白範本.docx"
    },
    {
      "slug": "private-statement",
      "label": "聲明書",
      "docType": "聲明書",
      "note": "聲明的是自己知道的事實，不要把推測或他人的行為寫成既成事實。",
      "path": "templates/private-statement.docx",
      "filename": "聲明書空白範本.docx"
    },
    {
      "slug": "private-settlement",
      "label": "和解書",
      "docType": "和解書",
      "note": "「拋棄範圍與保留事項」不要只寫「拋棄其餘一切請求」——傷勢或損害未確定時，寫「本件僅就○○和解，其餘保留」。",
      "path": "templates/private-settlement.docx",
      "filename": "和解書空白範本.docx"
    },
    {
      "slug": "private-employment-cert",
      "label": "在職證明書",
      "docType": "在職證明書",
      "note": "寫到職日、現職職稱與部門，並明確寫「迄今仍在職中」。薪資要不要寫看用途。",
      "path": "templates/private-employment-cert.docx",
      "filename": "在職證明書空白範本.docx"
    },
    {
      "slug": "private-separation-cert",
      "label": "離職證明書（服務證明書）",
      "docType": "服務證明書",
      "note": "離職事由要照實寫——要拿去請領失業給付時，那是就業保險法第 25 條第 4 項的法定必載事項。",
      "path": "templates/private-separation-cert.docx",
      "filename": "離職證明書（服務證明書）空白範本.docx"
    },
    {
      "slug": "certified-letter",
      "label": "存證信函內文",
      "docType": "存證信函",
      "note": "格式已依中華郵政使用說明設定；用紙請至中華郵政官網下載，再把內文貼上。",
      "path": "templates/certified-letter.docx",
      "filename": "存證信函內文空白範本.docx"
    }
  ]
