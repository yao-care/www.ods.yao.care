---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SERVICE_LINKS } from '../site.config.js';
import { CASES } from '../data/cases.js';
import index from '../data/scenarios.json';
import { CITIZEN_EXAMPLES } from '../data/citizen-examples.js';
import { FIXED_PAGES } from '../data/llms.js';
import { ORGANIZATION, SITE_URL } from '../data/schema.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const featured = ['grant-settlement', 'meeting-notice', 'noise-petition-reply', 'procurement-sign'];
const cards = CASES.filter((c) => featured.includes(c.slug));
// 民眾端明細頁原本首頁一條都沒直連，只能從 /citizens/ 進去，Google 因此遲遲不爬。
// 兩個族群各挑幾篇直連，讓兩邊的抓取深度一致。
const citizenFeatured = ['certified-letter', 'certified-letter-debt', 'petition-noise', 'subsidy-application'];
const citizenCards = citizenFeatured
  .map((slug) => CITIZEN_EXAMPLES.find((e) => e.slug === slug))
  .filter(Boolean);
const docTypeOf = (key) => index.items.find((i) => i.key === key)?.doc_type ?? '';
const agencyApplyLink = SERVICE_LINKS.agencyApply('home_agency_apply');
const selfRegisterLink = SERVICE_LINKS.selfRegister('home_self_register');

// 首頁原本只有 BaseLayout 的全站 Organization／WebSite，沒有 WebPage，也沒有任何
// 指向主幹的結構訊號。ItemList 取自 src/data/llms.js 的同一份清單，站台結構不抄第二次。
const hubs = FIXED_PAGES.filter((p) => p.hub);
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${SITE_URL}#webpage`,
      url: SITE_URL,
      name: '公文 AI｜機關公文、民眾書件與存證信函',
      description:
        `機關公文範例 ${CASES.length} 篇與民眾書件、存證信函 ${CITIZEN_EXAMPLES.length} 篇，` +
        '每篇都有全文與逐條格式檢核結果，另附各文別的 Word 空白範本。',
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': `${SITE_URL}#website` },
      about: ORGANIZATION,
      mainEntity: {
        '@type': 'ItemList',
        name: '公文 AI 的主要單元',
        numberOfItems: hubs.length,
        itemListElement: hubs.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: p.name,
          description: p.blurb,
          url: `https://www.ods.yao.care${p.path}`,
        })),
      },
    },
  ],
};
---

<BaseLayout
  schemas={[homeSchema]}
  title="公文 AI｜機關公文、民眾書件與存證信函"
  description="機關公文、民眾對機關的申請與陳情、個人或企業間的存證信函；提供草擬、格式檢核與純文字／Word 匯出。"
>
  <SiteHeader />
  <main id="main">
    <section class="hero">
      <h1>開案的時候，先看一份寫好的</h1>
      <p>
        補助核銷、陳情轉請、開會通知、公告、簽稿 —— 每一種都有完整範例全文，
        附上 24 條格式檢核逐條結果。一般民眾也能撰寫對機關的正式書件，
        個人或企業間則可整理存證信函草稿。
      </p>
      <div class="cta-row">
        <a class="primary" href={`${base}cases/`}>看公文範例</a>
        <a class="secondary" href={`${base}citizens/`}>看民眾書件與存證信函</a>
        <a class="secondary" href={`${base}writing/`}>看公文怎麼寫</a>
        <a class="secondary" href={`${base}usage/`}>查公文用語表</a>
        <a class="secondary" {...agencyApplyLink}>機關申請試用</a>
      </div>
    </section>

    <section>
      <h2>從案子找起</h2>
      <ul class="cards">
        {cards.map((c) => (
          <li>
            <a href={`${base}cases/${c.slug}/`}>
              <span class="doc-type">{docTypeOf(c.key)}</span>
              <span class="title">{c.seoTitle}</span>
              <span class="lead-sm">{c.lead}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href={`${base}cases/`}>看全部範例</a></p>
    </section>

    <section>
      <h2>自己要寫給機關或對方的</h2>
      <p class="section-lead">
        存證信函、陳情書、申請書 —— 不是承辦，是一般人遇到押金、借款、噪音、補助這些事的時候要寫的。
        格式一樣有規矩，寫錯一樣會被退。
      </p>
      <ul class="cards">
        {citizenCards.map((e) => (
          <li>
            <a href={`${base}citizens/${e.slug}/`}>
              <span class="doc-type">{e.draft.doc_type}</span>
              <span class="title">{e.seoTitle}</span>
              <span class="lead-sm">{e.lead}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href={`${base}citizens/`}>看全部民眾書件與存證信函</a>
        ・<a href={`${base}citizens/which-route/`}>陳情、訴願、申訴怎麼選</a>
        ・<a href={`${base}citizens/certified-letter-guide/`}>存證信函要多少錢、怎麼寄</a>
      </p>
    </section>

    <section>
      <h2>下載 Word 自己改</h2>
      <p class="section-lead">
        函、書函、公告、開會通知單、簽、陳情書、申請書、存證信函內文，各一份空白範本，
        版面取自政府文書格式參考規範原始檔，開啟就能改。
      </p>
      <p class="more"><a href={`${base}templates/`}>公文格式 Word 範本下載</a></p>
    </section>

    <section class="cols">
      <div>
        <h2>退件的通常不是內容，是格式</h2>
        <p>
          期望語對上級要用「請鑒核」、對平行機關用「請查照」；日期要民國紀年；
          金額要國字大寫；主旨不能分項。這些規則系統會逐條檢查，
          <a href={`${base}checks/`}>24 條檢核</a>全部列出來，不通過會指出哪一條。
        </p>
      </div>
      <div>
        <h2>稿件不會離開機關</h2>
        <p>
          送到模型之前，姓名、身分證號、電話、地址會先換成代稱，產出後再還原。
          去識別化服務不可用的時候，系統改用本機規則引擎組稿，不會把原文送出去。
          細節寫在<a href={`${base}security/`}>資料處理方式</a>。
        </p>
      </div>
    </section>

    <section class="who">
      <h2>三種使用方式</h2>
      <div class="cols">
        <div class="who-card">
          <h3>機關</h3>
          <p>鄉鎮市公所、縣市府各處室。由我們開通帳號並配置專屬網址，接上既有稿件庫。</p>
          <a class="primary" {...agencyApplyLink}>申請試用</a>
        </div>
        <div class="who-card">
          <h3>小型受補助單位</h3>
          <p>社區發展協會、學校家長會、農會、民間團體。核銷公文一樣要照格式，可以自己註冊。</p>
          <a class="secondary" {...selfRegisterLink}>自助註冊</a>
        </div>
        <div class="who-card">
          <h3>一般民眾／個人或企業</h3>
          <p>需要向機關申請、陳情、申訴，或要通知另一個人或企業？建立個人工作區即可開始。</p>
          <a class="primary" {...selfRegisterLink}>建立個人工作區</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  section + section {
    margin-top: 4rem;
  }
  .hero h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }
  .hero p {
    font-size: var(--text-base);
    line-height: 1.9;
    color: var(--color-ink-soft);
    max-width: 44rem;
    margin-top: 1rem;
  }
  .section-lead {
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-ink-soft);
    max-width: 44rem;
    margin-bottom: 1.25rem;
  }
  h2 {
    font-size: var(--text-xl);
    margin-bottom: 1rem;
  }
  h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.5rem;
  }
  p {
    font-size: var(--text-base);
    line-height: 1.9;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 1.5rem;
  }
  .primary {
    font-size: var(--text-base);
    background: var(--color-accent);
    color: var(--color-white);
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    text-decoration: none;
    justify-self: start;
  }
  .primary:hover {
    background: var(--color-accent-dark);
  }
  .secondary {
    font-size: var(--text-sm);
    color: var(--color-primary);
  }
  .cards {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .who .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cards a {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-white);
    text-decoration: none;
    color: var(--color-text);
  }
  .cards a:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary);
  }
  .doc-type {
    font-size: var(--text-xs);
    color: var(--color-primary);
  }
  .title {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .lead-sm {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    line-height: 1.7;
  }
  .more {
    margin-top: 1rem;
    font-size: var(--text-sm);
  }
  .cols {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .who-card {
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-white);
    display: grid;
    gap: 1rem;
    align-content: start;
  }
</style>
