---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { CASES, CATEGORIES } from '../../data/cases.js';
import index from '../../data/scenarios.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const docTypeOf = (key) => index.items.find((i) => i.key === key)?.doc_type ?? '';

// 案例庫是本站主體，但這個 hub 頁原本只有 BaseLayout 的全站兩條 schema，
// 明細頁 /cases/<slug>/ 反而有 Article＋麵包屑。列表頁補 CollectionPage 才接得起來。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      name: '公文範例庫',
      description:
        `核銷、陳情轉請、開會通知、公告、簽稿等 ${CASES.length} 則公文範例全文，每一則都附 24 條格式檢核結果。`,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@type': 'WebSite', url: 'https://www.ods.yao.care/' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: CASES.length,
        itemListElement: CASES.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.seoTitle,
          url: new URL(`${base}cases/${c.slug}/`, Astro.site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '公文範例', item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title="公文範例庫｜公文 AI"
  description="核銷、陳情轉請、開會通知、公告、簽稿等公文範例全文，每一則都附 24 條格式檢核結果。"
>
  <SiteHeader />
  <main>
    <h1>公文範例庫</h1>
    <p class="lead">
      每一則都是完整的公文全文，附上 24 條格式檢核逐條結果。點進去可以照實際流程試做一次。
    </p>

    <p class="cross">
      第一次寫、想先弄懂主旨與說明怎麼分段的話，先看<a href={`${base}writing/`}>公文怎麼寫</a>。
    </p>

    <p class="cross">
      不是機關承辦？向機關申請、陳情，或要通知個人與企業的話，看
      <a href={`${base}citizens/`}>民眾書件與存證信函範例</a>。
      各文別的空白 Word 範本在<a href={`${base}templates/`}>範本下載</a>。
    </p>

    {CATEGORIES.map((cat) => (
      <section>
        <h2>{cat}</h2>
        <ul class="cards">
          {CASES.filter((c) => c.category === cat).map((c) => (
            <li>
              <a href={`${base}cases/${c.slug}/`}>
                <span class="doc-type">{docTypeOf(c.key)}</span>
                <span class="title">{c.seoTitle}</span>
                <span class="lead-sm">{c.lead}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  h1 {
    font-size: var(--text-2xl);
  }
  h2 {
    font-size: var(--text-xl);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .lead {
    font-size: var(--text-base);
    line-height: 1.9;
    color: var(--color-ink-soft);
    margin-top: 1rem;
  }
  .cross {
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-ink-soft);
    margin-top: 1rem;
    padding: 1rem 0;
    border-block: 1px solid var(--color-line);
  }
  .cross a {
    color: var(--color-primary);
  }
  .cards {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cards a {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-white);
    text-decoration: none;
    color: var(--color-text);
  }
  .cards a:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary);
  }
  .doc-type {
    font-size: var(--text-xs);
    color: var(--color-primary);
  }
  .title {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .lead-sm {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    line-height: 1.7;
  }
</style>
