    "sections": [
      {
        "title": "委託事由",
        "items": [
          "本人張美玲因出國無法親自辦理車輛過戶事宜，特立此委託書。"
        ]
      },
      {
        "title": "委託事項",
        "items": [
          "委託陳建豪代為向監理機關辦理車牌號碼○○○-○○○○號自用小客車之過戶登記。",
          "委託陳建豪代為簽署過戶登記相關表單。",
          "委託陳建豪代為領取新行照。",
          "依道路交通安全規則第16條規定，代辦人應另繳驗其國民身分證及本人有效之駕駛執照。",
          "如有虛偽不實及任何紛爭，本人願負相關法律責任。"
        ]
      },
      {
        "title": "委託期間",
        "items": [
          "自114年9月1日起至114年10月31日止。"
        ]
      },
      {
        "title": "附件",
        "items": [
          "檢附行車執照正本。",
          "檢附代辦人國民身分證。",
          "檢附委託人有效駕駛執照。"
        ]
      }
    ],
