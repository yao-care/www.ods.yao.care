    "sections": [
      {
        "title": "委託事由",
        "items": [
          "本人林秀英因工作時間無法親自前往戶政事務所辦理相關事務，特委託王志明君代為處理。"
        ]
      },
      {
        "title": "委託事項",
        "items": [
          "委託王志明君代為向○○區戶政事務所申請並領取本人林秀英之戶籍謄本1份。",
          "受託人王志明君應持本委託書及雙方身分證件辦理前項事宜。",
          "如有虛偽不實及任何紛爭，本人願負相關法律責任。"
        ]
      },
      {
        "title": "委託期間",
        "items": [
          "委託期間至114年12月31日止。"
        ]
      },
      {
        "title": "附件",
        "items": [
          "檢附委託人身分證影本1份。",
          "檢附受託人身分證影本1份。"
        ]
      }
    ],
