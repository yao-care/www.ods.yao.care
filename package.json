{
  "name": "www.ods.yao.care",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-design.mjs && node scripts/check-contrast.mjs && node scripts/check-content.mjs && node scripts/check-zh-hant.mjs && node scripts/check-scenarios.mjs && node scripts/build-docx.mjs && astro build && node scripts/check-anchors.mjs && node scripts/check-og.mjs",
    "preview": "astro preview",
    "check:design": "node scripts/check-design.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:content:all": "node scripts/check-content.mjs --all",
    "check:zh-hant": "node scripts/check-zh-hant.mjs",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:og": "node scripts/check-og.mjs",
    "gen:brand": "python3 scripts/gen-brand-images.py",
    "build:docx": "node scripts/build-docx.mjs",
    "fetch:gov-template": "node scripts/fetch-gov-template.mjs",
    "gen:simplified-set": "python3 scripts/gen-simplified-set.py",
