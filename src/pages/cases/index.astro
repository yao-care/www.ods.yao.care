---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { CASES, CATEGORIES } from '../../data/cases.js';
import index from '../../data/scenarios.json';
// 條目數取實際產物，不寫死 —— 函與開會通知單各有一組，數字改版時這頁跟著變。
import letterSample from '../../data/scenarios/grant_report.json';
import meetingSample from '../../data/scenarios/meeting.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const docTypeOf = (key) => index.items.find((i) => i.key === key)?.doc_type ?? '';
const letterChecks = letterSample.checks.length;
const meetingChecks = meetingSample.checks.length;

// 案例庫是本站主體，但這個 hub 頁原本只有 BaseLayout 的全站兩條 schema，
// 明細頁 /cases/<slug>/ 反而有 Article＋麵包屑。列表頁補 CollectionPage 才接得起來。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      name: '公文範例庫',
      description:
        `核銷、陳情轉請、開會通知、公告、簽稿等 ${CASES.length} 則公文範例全文，每一則都附逐條格式檢核結果。`,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@type': 'WebSite', url: 'https://www.ods.yao.care/' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: CASES.length,
        itemListElement: CASES.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.seoTitle,
          url: new URL(`${base}cases/${c.slug}/`, Astro.site).href,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '公文範例', item: pageUrl },
      ],
    },
  ],
};

// 列表頁原本只有 CollectionPage。「公文範例去哪裡找」「補助核銷公文怎麼寫」
// 這類問句的落點就是這一頁，補上 FAQPage 才吃得到問句型結果。
const faqPairs = [
  {
    q: '公文範例去哪裡找？',
    a: `這一頁收了 ${CASES.length} 則地方機關的公文全文，涵蓋函、書函、公告、簽與開會通知單，`
      + '每一則都是完整的一份文件，包含受文者、主旨、分項說明與期望語，並附逐條格式檢核結果。'
      + '各文別的空白 Word 範本另外放在範本下載頁。',
  },
  {
    q: '補助經費核銷的公文怎麼寫？',
    a: '用「函」行文給補助機關，主旨寫明檢陳哪一年度、哪個計畫的核銷資料與期望語；'
      + '說明段交代核定金額、實支金額與餘款繳回方式；金額依公文書橫式書寫數字使用原則處理，'
      + '附件清單逐項列出。範例庫的補助經費核銷那則是完整全文。',
  },
  {
    q: '這些範例可以直接拿來改嗎？',
    a: '可以。每一則都提供 Word 檔下載，版面數值取自政府文書格式參考規範的原始檔，'
      + '下載後直接編輯即可。範例中的機關、人名與案號都是虛構的，套用前要換成實際資料。',
  },
  {
    q: '公文格式檢核會檢查幾條？',
    a: `依文別而定：函、書函、公告、簽是 ${letterChecks} 條；`
      + `開會通知單是固定欄位表單，不套主旨與段落那兩組，改查它自己的欄位，共 ${meetingChecks} 條。`,
  },
];
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPairs.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
---

<BaseLayout
  schemas={[schema, faq]}
  title="公文範例庫｜公文 AI"
  description="核銷、陳情轉請、開會通知、公告、簽稿等公文範例全文，每一則都附逐條格式檢核結果。"
>
  <SiteHeader />
  <main id="main">
    <h1>公文範例庫</h1>
    <p class="lead">
      每一則都是完整的公文全文，附上逐條格式檢核結果（函、簽、書函、公告 {letterChecks} 條；
      開會通知單是固定欄位表單，另有 {meetingChecks} 條）。點進去可以照實際流程試做一次。
    </p>

    <p class="cross">
      第一次寫、想先弄懂主旨與說明怎麼分段的話，先看<a href={`${base}writing/`}>公文怎麼寫</a>。
    </p>

    <p class="cross">
      不是機關承辦？向機關申請、陳情，或要通知個人與企業的話，看
      <a href={`${base}citizens/`}>民眾書件與存證信函範例</a>。
      各文別的空白 Word 範本在<a href={`${base}templates/`}>範本下載</a>。
    </p>

    {CATEGORIES.map((cat) => (
      <section>
        <h2>{cat}</h2>
        <ul class="cards">
          {CASES.filter((c) => c.category === cat).map((c) => (
            <li>
              <a href={`${base}cases/${c.slug}/`}>
                <span class="doc-type">{docTypeOf(c.key)}</span>
                <span class="title">{c.seoTitle}</span>
                <span class="lead-sm">{c.lead}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  h1 {
    font-size: var(--text-2xl);
  }
  h2 {
    font-size: var(--text-xl);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .lead {
    font-size: var(--text-base);
    line-height: 1.9;
    color: var(--color-ink-soft);
    margin-top: 1rem;
  }
  .cross {
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--color-ink-soft);
    margin-top: 1rem;
    padding: 1rem 0;
    border-block: 1px solid var(--color-line);
  }
  .cross a {
    color: var(--color-primary);
  }
  .cards {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cards a {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-white);
    text-decoration: none;
    color: var(--color-text);
  }
  .cards a:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary);
  }
  .doc-type {
    font-size: var(--text-xs);
    color: var(--color-primary);
  }
  .title {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .lead-sm {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
    line-height: 1.7;
  }
</style>
