---
/**
 * 仿真體驗器：操作流程與應用一致（填寫 → 產生草稿 → 看檢核 → 編輯／匯出），
 * 支援機關公文、民眾對機關書件與存證信函；一切都是靜態的，凡會改變狀態的動作一律攔截。
 *
 * 漸進增強：伺服器端就把公文全文與檢核結果渲染出來，沒有 JavaScript 時整頁照樣可讀
 * （搜尋引擎讀得到公文全文，這是本站被搜到的關鍵）。JS 載入後才收合成互動流程。
 */
interface Props {
  scenario: { key: string; title: string; source: string };
  draft: {
    subject: string;
    doc_type: string;
    sections: { title: string; items: string[] }[];
    fields?: Record<string, unknown>;
  };
  checks: { id: string; title: string; severity: string; ok: boolean; detail?: string }[];
  receiver: string | null;
  family?: 'official' | 'citizen' | 'notice' | 'private';
  /** 正式格式的 Word 檔（由 scripts/build-docx.mjs 依政府文書格式參考規範產生）。 */
  download?: { path: string; filename: string } | null;
}
import { SERVICE_LINKS } from '../site.config.js';
import { meetingFields } from '../data/meeting.js';

const { scenario, draft, checks, receiver } = Astro.props;
/**
 * 開會通知單的固定欄位（cases.js 的 meeting）。給了就用固定欄位渲染，不用主旨／說明／辦法。
 *
 * 為什麼要有這個分支（2026-08-20）：政府文書格式參考規範第八點的開會通知單是固定欄位表單
 * ——開會事由、開會時間、開會地點、主持人、聯絡人及電話、出席者、列席者、備註——
 * **沒有主旨、沒有說明、沒有辦法**。下載的 Word 早就照規範排好了（scripts/lib/gov-format.mjs），
 * 但頁面一直顯示函的形狀，跟同一頁的 watchOut「時間、地點寫進主旨反而不合格式」自相矛盾。
 */
const meeting = Astro.props.meeting ?? null;
// 欄位與順序照規範第八點，與下載的 Word 共用同一支（src/data/meeting.js）。
// 上一版只渲染有值的六個欄位，漏了規範裡同樣存在的「列席者」「副本」與「備註」。
const meetingRows = meeting ? meetingFields(draft, meeting) : [];
const download = Astro.props.download ?? null;
const family = Astro.props.family ?? draft.document_family ?? 'official';
const isOfficial = family === 'official';
const isNotice = family === 'notice';
const fields = draft.fields ?? {};
const sender = fields.sender ? String(fields.sender) : '（示範發文人）';
const effectiveReceiver = receiver ?? (fields.receiver ? String(fields.receiver) : null);
const addresses = {
  sender: fields.sender_address ? String(fields.sender_address) : '',
  receiver: fields.receiver_address ? String(fields.receiver_address) : '',
};
const deadline = fields.deadline ? String(fields.deadline) : '';
const attachments = Array.isArray(fields.attachments) ? fields.attachments.join('、') : '';
const title = isNotice ? '存證信函' : draft.doc_type;
const isPrivate = family === 'private';
const steps = isOfficial
  ? ['填寫事由', '產生草稿', '格式檢核', '送出簽核']
  : [
      isNotice ? '填寫通知' : isPrivate ? '填寫事實與委託內容' : '填寫事情與請求',
      '產生草稿',
      '格式檢核',
      '下載文件',
    ];
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const passed = checks.filter((c) => c.ok).length;
---

<section class="demo" data-demo data-family={family} data-doc-title={title} data-check-count={checks.length}>
  <ol class="steps" aria-label="操作步驟">
    {steps.map((step, index) => <li data-step={index + 1} class={index === 0 ? 'on' : undefined}>{step}</li>)}
  </ol>

  <form class="compose" data-compose>
    <label>
      <span>{isOfficial ? '事由' : isNotice ? '事實經過與要求' : '事情經過與請求'}</span>
      <textarea rows="3" readonly data-gate="edit-source">{scenario.source}</textarea>
    </label>
    {isOfficial ? (
      <div class="row">
        <label>
          <span>文別</span>
          <input type="text" value={draft.doc_type} readonly data-gate="edit-meta" />
        </label>
        <label>
          <span>受文者</span>
          <input type="text" value={effectiveReceiver ?? '（無）'} readonly data-gate="edit-meta" />
        </label>
      </div>
    ) : (
      <div class="row">
        <label>
          <span>{isNotice ? '寄件人' : '發文人'}</span>
          <input type="text" value={sender} readonly data-gate="edit-meta" />
        </label>
        <label>
          <span>{isNotice ? '收件人' : '受文機關'}</span>
          <input type="text" value={effectiveReceiver ?? '（示範收文者）'} readonly data-gate="edit-meta" />
        </label>
      </div>
    )}
    {isNotice && (
      <div class="row">
        <label>
          <span>寄件人地址</span>
          <input type="text" value={addresses.sender} readonly data-gate="edit-meta" />
        </label>
        <label>
          <span>收件人地址</span>
          <input type="text" value={addresses.receiver} readonly data-gate="edit-meta" />
        </label>
      </div>
    )}
    {!isOfficial && (
      <div class="row">
        <label>
          <span>{isNotice ? '履行／回覆期限' : '附件'}</span>
          <input type="text" value={isNotice ? deadline : attachments} readonly data-gate="edit-meta" />
        </label>
        <label>
          <span>文別</span>
          <input type="text" value={title} readonly data-gate="edit-meta" />
        </label>
      </div>
    )}
    <button type="button" class="primary" data-generate>產生草稿</button>
    <p class="hint">
      {isOfficial
        ? '這是範例事由。要改成貴機關自己的案子，需要帳號。'
        : '這是範例內容。要換成自己的事情、資料與請求，需要建立工作區。'}
    </p>
  </form>

  <div class="progress" data-progress hidden>
    <p data-progress-text>檢索機關知識庫與既有稿件…</p>
    <div class="track"><span data-progress-bar></span></div>
  </div>

  <article class="result" data-result>
    <header class="result-head">
      <h3>{isOfficial ? `${draft.doc_type}稿` : `${title}草稿`}</h3>
      {isOfficial ? (
        <p class="meta">{effectiveReceiver ? `受文者：${effectiveReceiver}` : '無受文者'}</p>
      ) : (
        <>
          <p class="meta">{isNotice ? `寄件人：${sender}` : `發文人：${sender}`}　{isNotice ? '收件人' : '受文機關'}：{effectiveReceiver}</p>
          {isNotice && <p class="meta">寄件人地址：{addresses.sender}　收件人地址：{addresses.receiver}　期限：{deadline}</p>}
        </>
      )}
    </header>

    <div class="doc">
      {meeting ? (
        <dl class="fixed-fields">
          {meetingRows.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>
                {f.items
                  ? (f.items.length
                      ? <ol>{f.items.map((it) => <li>{it}</li>)}</ol>
                      : <span class="blank">（待填）</span>)
                  : (f.value || <span class="blank">（待填）</span>)}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <>
          <p class="subject"><strong>主旨：</strong>{draft.subject}</p>
          {draft.sections.map((s) => (
            <div class="section">
              <p class="section-title"><strong>{s.title}：</strong></p>
              <ol>{s.items.map((it) => <li>{it}</li>)}</ol>
            </div>
          ))}
        </>
      )}
    </div>

    <div class="checks">
      <p class="checks-head">
        {isOfficial ? '格式檢核' : '民眾文件檢核'} <strong>{passed}/{checks.length}</strong> 通過
      </p>
      {meeting && (
        <p class="checks-note">
          開會通知單是固定欄位表單，沒有主旨與段落，所以不套用函的 6 條主旨檢核與 5 條段落檢核，
          改查規範第八點的固定欄位（開會事由、時間、地點、主持人、聯絡人及電話、出席者），共 {checks.length} 條。
        </p>
      )}
      <ul>
        {checks.map((c) => (
          <li class={c.ok ? 'ok' : 'bad'}>
            <span class="mark" aria-hidden="true">{c.ok ? '✓' : '✗'}</span>
            <span class="name">{c.title}</span>
            {!c.ok && c.detail && <span class="why">{c.detail}</span>}
          </li>
        ))}
      </ul>
    </div>

    <div class="actions">
      <button type="button" data-gate="edit">開啟編輯</button>
      <button type="button" data-gate="save">儲存並重新檢核</button>
      {isOfficial && <button type="button" data-gate="confirm">簽核確認</button>}
      {download ? (
        <a class="download" href={`${base}downloads/${download.path}`} download={download.filename}>
          下載 Word（正式格式）
        </a>
      ) : (
        <button type="button" data-gate="export">匯出文件</button>
      )}
    </div>
    {download && (
      <p class="download-note">
        {isNotice
          ? '下載的是存證信函內文，字體、行高與字元間距已依中華郵政使用說明設定，貼進郵局官方用紙即可。'
          : `下載的${title}已套用${isOfficial ? '政府文書格式參考規範' : '規範'}的紙張、邊界、字級與縮排，開啟後直接改成自己的內容。`}
      </p>
    )}
  </article>
</section>

<dialog class="gate" data-gate-dialog>
  <h3 data-gate-title>這一步需要帳號</h3>
  <p data-gate-body></p>
  <div class="gate-actions">
    {isOfficial ? (
      <>
        <a class="primary" {...SERVICE_LINKS.agencyApply('demo_agency_apply')}>機關申請試用</a>
        <a class="secondary" {...SERVICE_LINKS.selfRegister('demo_self_register')}>小型單位自助註冊</a>
      </>
    ) : (
      <a class="primary" {...SERVICE_LINKS.selfRegister('demo_self_register')}>建立個人工作區</a>
    )}
    <button type="button" data-gate-close>返回範例</button>
  </div>
</dialog>

<script>
  const GATE_COPY = {
    official: {
      'edit-source': ['換成自己的案子', '把事由改成貴機關正在辦的案子，需要帳號 —— 草擬會依貴機關的稿件庫與慣用語調整。'],
      'edit-meta': ['調整文別與受文者', '文別與受文者會影響期望語與段落結構。要自己選，需要帳號。'],
      edit: ['編輯這份稿件', '編輯後系統會重新跑一次格式檢核。這一步會寫進貴機關的稿件庫，需要帳號。'],
      save: ['儲存並重新檢核', '儲存會寫進貴機關的稿件庫並留下稽核軌跡，需要帳號。'],
      confirm: ['送出簽核', '簽核確認會鎖定稿件、記錄簽核人與時間，需要帳號。'],
      export: ['匯出純文字', '匯出的檔案會帶貴機關的發文格式，需要帳號。'],
    },
    citizen: {
      'edit-source': ['換成自己的事情', '把範例換成自己的事實經過與請求，需要建立個人工作區。'],
      'edit-meta': ['調整發文人與受文機關', '發文人、受文機關與附件會留在工作區，產出後再依內容重新檢核。'],
      edit: ['編輯這份陳情書', '編輯後系統會重新檢查主旨、段落、請求事項與個資格式，需要工作區。'],
      save: ['儲存並重新檢核', '儲存會保留這份文件，並依民眾書件規則重新檢核，需要工作區。'],
      export: ['匯出文件', '匯出的純文字或 Word 會保留發文人、受文機關與附件欄位，需要工作區。'],
    },
    private: {
      'edit-source': ['換成自己的事情', '把範例換成自己要委託、切結或聲明的內容，需要建立個人工作區。'],
      'edit-meta': ['調整文別與雙方資料', '委託書、授權書、切結書、聲明書的段落與必要欄位各不相同，要自己選，需要工作區。'],
      edit: ['編輯這份文件', '編輯後系統會重新檢查段落、責任文句與個資格式，需要工作區。'],
      save: ['儲存並重新檢核', '儲存會保留這份草稿，並依民間書件規則重新檢核，需要工作區。'],
      export: ['匯出文件', '匯出的是可人工審閱的草稿；機關另有制式表格時以該機關的表格為準。'],
    },
    notice: {
      'edit-source': ['換成自己的通知事項', '把範例換成自己的事實、請求與期限，需要建立個人工作區。'],
      'edit-meta': ['調整雙方資料與期限', '寄件人、收件人、雙方地址與履行期限都是存證信函的必要欄位，需要工作區。'],
      edit: ['編輯這份存證信函', '編輯後系統會重新檢查必要欄位、段落與個資格式，需要工作區。'],
      save: ['儲存並重新檢核', '儲存會保留這份草稿，並依存證信函規則重新檢核，需要工作區。'],
      export: ['匯出文件', '匯出的純文字或 Word 是可人工審閱的草稿，不代表已完成郵寄或送達。'],
    },
  };

  const STAGES = {
    official: [
      ['檢索機關知識庫與既有稿件…', 25],
      ['去識別化：姓名、身分證、電話、地址…', 50],
      ['產生草稿…', 80],
      ['執行 {n} 條格式檢核…', 100],
    ],
    citizen: [
      ['整理事情經過與請求…', 25],
      ['去識別化：姓名、電話、地址…', 50],
      ['產生陳情書草稿…', 80],
      ['執行民眾文件檢核…', 100],
    ],
    private: [
      ['整理事實與委託／切結內容…', 25],
      ['去識別化：姓名、身分證、電話、地址…', 50],
      ['產生草稿…', 80],
      ['執行 {n} 條檢核（含責任文句）…', 100],
    ],
    notice: [
      ['整理通知事項與履行期限…', 25],
      ['去識別化：姓名、電話、地址…', 50],
      ['產生存證信函草稿…', 80],
      ['執行存證信函檢核…', 100],
    ],
  };

  document.querySelectorAll('[data-demo]').forEach((root) => {
    const family = root.dataset.family ?? 'official';
    const docTitle = root.dataset.docTitle ?? '文件';
    const rawGateCopy = GATE_COPY[family] ?? GATE_COPY.official;
    const gateCopy = Object.fromEntries(
      Object.entries(rawGateCopy).map(([key, copy]) => [
        key,
        [copy[0].replace('陳情書', docTitle), copy[1]],
      ]),
    );
    // 條目數依文別而定（函／簽／書函 24 條、公告 23 條、開會通知單 22 條），
    // 所以進度文字裡的數字取自這一頁實際烘進來的檢核筆數，不寫死。
    const checkCount = root.dataset.checkCount ?? '';
    const stages = (STAGES[family] ?? STAGES.official).map(([label, percent]) => [
      label.replace('{n}', checkCount),
      percent,
    ]);
    const result = root.querySelector('[data-result]');
    const progress = root.querySelector('[data-progress]');
    const progressText = root.querySelector('[data-progress-text]');
    const progressBar = root.querySelector('[data-progress-bar]');
    const generate = root.querySelector('[data-generate]');
    const steps = root.querySelectorAll('[data-step]');
    const dialog = document.querySelector('[data-gate-dialog]');

    // 有 JS 才收合：無 JS 時公文全文與檢核結果本來就看得到
    result.hidden = true;

    const setStep = (n) => steps.forEach((li) => li.classList.toggle('on', Number(li.dataset.step) <= n));

    generate?.addEventListener('click', () => {
      generate.disabled = true;
      progress.hidden = false;
      setStep(2);
      let i = 0;
      const tick = () => {
        const [text, pct] = stages[i];
        progressText.textContent = text;
        progressBar.style.width = `${pct}%`;
        if (i === 3) setStep(3);
        i += 1;
        if (i < stages.length) {
          setTimeout(tick, 700);
        } else {
          setTimeout(() => {
            progress.hidden = true;
            result.hidden = false;
            result.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 600);
        }
      };
      tick();
    });

    root.querySelectorAll('[data-gate]').forEach((el) => {
      const open = (event) => {
        event.preventDefault();
        const [title, body] = gateCopy[el.dataset.gate] ?? ['需要帳號', '這一步需要帳號。'];
        dialog.querySelector('[data-gate-title]').textContent = title;
        dialog.querySelector('[data-gate-body]').textContent = body;
        if (el.dataset.gate === 'confirm' || el.dataset.gate === 'export') setStep(4);
        dialog.showModal();
      };
      el.addEventListener('click', open);
      el.addEventListener('focus', () => el.blur());
    });

    dialog?.querySelector('[data-gate-close]')?.addEventListener('click', () => dialog.close());
  });
</script>

<style>
  .fixed-fields .blank {
    color: var(--color-ink-muted);
  }
  .fixed-fields ol {
    margin: 0;
    padding-inline-start: 1.5rem;
  }

  .fixed-fields {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .fixed-fields > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem;
  }
  .fixed-fields dt {
    font-weight: 600;
  }
  .fixed-fields dd {
    margin: 0;
  }
  .checks-note {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    line-height: 1.9;
    margin-block: 0.5rem 1rem;
  }

  .demo {
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-white);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem 1.25rem;
    list-style: none;
    background: var(--color-bg-light);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step) '. ';
  }
  .steps li + li::before {
    content: '→ ' counter(step) '. ';
  }
  .steps li.on {
    color: var(--color-primary);
    font-weight: 700;
  }

  .compose {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }
  .compose label {
    display: grid;
    gap: 0.375rem;
  }
  .compose span {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
  .compose textarea,
  .compose input {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg-light);
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    padding: 0.75rem;
    width: 100%;
    cursor: pointer;
  }
  .row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .hint {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  button.primary,
  .gate-actions .primary {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    background: var(--color-accent);
    color: var(--color-white);
    border: 0;
    border-radius: 0.375rem;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    justify-self: start;
    text-decoration: none;
  }
  button.primary:hover {
    background: var(--color-accent-dark);
  }
  button.primary:disabled {
    background: var(--color-ink-muted);
    cursor: default;
  }

  .progress {
    padding: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .progress p {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: 0.75rem;
  }
  .track {
    height: 0.5rem;
    background: var(--color-bg-light);
    border-radius: 0.25rem;
    overflow: hidden;
  }
  .track span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-primary);
    transition: width 0.6s ease;
  }

  .result {
    border-top: 1px solid var(--color-line);
  }
