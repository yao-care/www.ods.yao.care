---
/**
 * 公文怎麼寫：函的主旨／說明／辦法、簽的主旨／說明／擬辦，以及擬稿的官方規定。
 *
 * 為什麼有這一頁（2026-08-20）：實搜「公文範例」，前排是政大、清大、成大、中央
 * 秘書室的**教學** PDF（公文用字、稱謂、上行平行下行文的期望語差異、核稿要點）——
 * 使用者要的是「教我怎麼寫」，不是「給我看一則」。本站十則案例全文回答的是後者。
 * 判定過程見 docs/keyword-validation/2026-08-20-pinned-14.md。
 *
 * 資料來自 src/data/gov-terms.json 的 drafting 區塊，由 scripts/fetch-gov-terms.py
 * 解析行政院《文書處理手冊》官方 PDF 產生。**不要在這頁手寫規則。**
 */
import ArticlePage from '../../layouts/ArticlePage.astro';
import PageToc from '../../components/PageToc.astro';
import terms from '../../data/gov-terms.json';
import { CASES } from '../../data/cases.js';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const { drafting, sign, numberRules, workflow, _source: source, _generated: generated } = terms;

/** 三段各自的官方原文，配上一句白話說明它實際上在回答什麼問題。 */
const SECTIONS = [
  {
    name: '主旨',
    asks: '這份公文要對方做什麼？',
    rule: drafting.sections.subject,
    hint: '不分項、一段到底、句末帶期望語。這是最常被退的地方。',
  },
  {
    name: '說明',
    asks: '為什麼？依據是什麼？前情如何？',
    rule: drafting.sections.explanation,
    hint: '主旨塞不下的事實、來源與理由放這裡；函覆要在第一項引敘來文日期與字號。',
  },
  {
    name: '辦法',
    asks: '具體要對方怎麼做？',
    rule: drafting.sections.method,
    hint: '段名可以換成「建議」「請求」「擬辦」「公告事項」「核示事項」。',
  },
];

const caseByKey = Object.fromEntries(CASES.map((c) => [c.key, c]));
const showcase = ['grant_report', 'subsidy_apply', 'petition_reply'].map((k) => caseByKey[k]).filter(Boolean);

const description =
  '函的主旨、說明、辦法與簽的主旨、說明、擬辦分別怎麼寫，先簽後稿與簽稿併陳的分野，'
  + '速別、密等、正本副本等稿面欄位怎麼填，以及陳核、核稿、會稿、閱稿、判行各關看什麼，'
  + '逐條取自行政院文書處理手冊官方版本。';

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const faqPairs = [
  {
    q: '公文的主旨要怎麼寫？',
    a: '主旨是全文精要，說明行文目的與期望，應力求具體扼要；不分項，文字緊接段名冒號之右書寫。'
      + '概括的期望語（請核示、請查照、請照辦）列入主旨，不在辦法段重複。',
  },
  {
    q: '什麼時候要寫「說明」段？',
    a: '當案情必須就事實、來源或理由作較詳細的敘述，無法在主旨內容納時才用說明段。'
      + '主旨、說明、辦法三段可以靈活運用，一段能寫完就不必勉強湊成兩段、三段。',
  },
  {
    q: '函覆公文要注意什麼？',
    a: '訂有辦理或復文期限的，期限要寫進主旨；擬辦復文或轉行的稿件，要敘入來文機關的發文日期與字號，'
      + '以便查考。引敘原文時直接語氣要改成間接語氣，「貴」「鈞」要改成「本」「該」。',
  },
  {
    q: '簽跟函的三段一樣嗎？',
    a: '不一樣。函是主旨、說明、辦法；簽是主旨、說明、擬辦。擬辦是簽的重點所在，'
      + '要針對案情提出具體處理意見或解決方案。手冊還規定各段應截然劃分：'
      + '說明段不提擬辦意見，擬辦段不重複說明。',
  },
  {
    q: '什麼時候要先簽後稿？',
    a: '政策性或重大興革案件、牽涉較廣而會商未獲結論的案件、擬提決策會議討論的案件、'
      + '重要人事案件，以及其他性質重要必須先行簽請核定的案件。'
      + '案情簡單或例行承轉的，以稿代簽即可。',
  },
  {
    q: '公文的「速別」要怎麼填？',
    a: '速別指的是希望受文機關辦理的速別，應確實考量案件性質，填「最速件」、「速件」或「普通件」。'
      + '如果是限期公文，則不必填列速別。',
  },
  {
    q: '正本和副本差在哪裡？',
    a: '正本與副本都要分別逐一書明全銜，或以明確的總稱概括表示；地址非眾所周知的要註明。'
      + '機關內部另可用加發「抄本（件）」的方式處理。實務上的差別在於誰有辦理義務、誰只是知悉。',
  },
  {
    q: '核稿、會稿、閱稿、判行分別是誰在做？',
    a: '手冊把文書處理分成收文處理、文件簽辦、文稿擬判、發文處理、歸檔處理五個步驟。'
      + '核決權責區分為初核（承辦人的直接主管）、覆核（直接主管的上級核稿者）、'
      + '會核（與本案有關的主管人員）與決定者（依分層負責規定的最後決定人）。'
      + '文稿的判行按分層負責規定辦理，同意發文批示「發」，不必繕發或尚須考慮的批「不發」或「緩發」。',
  },
  {
    q: '公文送會出去，沒表示意見會怎樣？',
    a: '各單位對其他單位送會的簽稿如有意見應即提出；未提出意見，一經會簽即視為同意，'
      + '並應共同負責。會稿單位有不同意見時，由主辦單位綜合修改後再送決定。'
      + '非政策性的緊急文稿，為爭取時效得先發後會。',
  },
  {
    q: '一份來文講了好幾件事怎麼辦？',
    a: '擬稿以一文一事為原則。來文如果是一文數事，可以分成數文答復。',
  },
];

// 章節的單一真實來源：<h2> 的 id 與文字、目錄的連結全部取這一份。
// 錨點存在與否由 scripts/check-anchors.mjs 在 build 後守門。
const S = {
  sections: { id: 'three-sections', label: '一、三段各自在回答什麼' },
  letter: { id: 'letter-notes', label: `二、「函」的 ${drafting.letterNotes.length} 條撰擬要領` },
  sign: { id: 'sign', label: '三、「簽」不是「函」：三段是主旨、說明、擬辦' },
  announce: { id: 'announcement', label: '四、「公告」是第三種：主旨、依據、公告事項' },
  fields: { id: 'draft-fields', label: `五、稿面上要填的 ${workflow.draftFields.length} 個欄位：速別、密等、正本副本` },
  cautions: { id: 'cautions', label: `六、擬稿的 ${drafting.cautions.length} 條注意事項` },
  numbers: { id: 'numbers', label: '七、數字什麼時候用阿拉伯數字、什麼時候用中文數字' },
  flow: { id: 'workflow', label: '八、擬好之後：陳核、核稿、會稿、閱稿、判行' },
  quality: { id: 'quality', label: '九、公文書的品質要求' },
  examples: { id: 'examples', label: '看規則怎麼落到紙上' },
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: pageUrl,
      headline: '公文怎麼寫：函與簽的三段、稿面欄位與核稿流程',
      description,
      author: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      publisher: { '@type': 'Organization', name: '藥提醒科技有限公司', url: 'https://www.yao.care/' },
      inLanguage: 'zh-Hant-TW',
      citation: {
        '@type': 'Legislation',
        name: `${source.issuer}《${source.name}》${source.edition}`,
        url: source.url,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://www.ods.yao.care/' },
        { '@type': 'ListItem', position: 2, name: '公文怎麼寫', item: pageUrl },
      ],
    },
  ],
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPairs.map((p) => ({
    '@type': 'Question',
    name: p.q,
    acceptedAnswer: { '@type': 'Answer', text: p.a },
  })),
};
---

<ArticlePage
  schemas={[schema, faq]}
  title="公文怎麼寫：函與簽的三段、稿面欄位與核稿流程｜公文 AI"
  description={description}
  heading="公文怎麼寫"
  lead="三段式不是填空題，而且函、簽、公告的三段各不相同。搞清楚每一段在回答什麼問題，剩下的就是把話講清楚。"
>
  <p class="cross">
    這頁講規則。要看規則落在真實公文裡長什麼樣，<a href={`${base}cases/`}>公文範例庫</a>每一則都是完整全文；
    稱謂語與期望語怎麼配對象，查<a href={`${base}usage/`}>公文用語表</a>。
  </p>

  <PageToc items={Object.values(S)} />

  <h2 id={S.sections.id}>{S.sections.label}</h2>
  {SECTIONS.map((s) => (
    <section class="seg">
      <h3>{s.name}：{s.asks}</h3>
      <p>{s.hint}</p>
      <blockquote>{s.rule}</blockquote>
    </section>
  ))}
  <p class="note">{drafting.sections.flexible}</p>

  <h2 id={S.letter.id}>{S.letter.label}</h2>
  <p>手冊對「函」的正文另外點名了這幾件事，都是承辦最常漏的。</p>
  <ol class="rules">
    {drafting.letterNotes.map((t) => <li>{t}</li>)}
  </ol>

  <h2 id={S.sign.id}>{S.sign.label}</h2>
  <p>
    這是最容易搞混的地方 —— 簽的第三段叫「<strong>擬辦</strong>」，不是「辦法」。
    簽是對內陳報長官核示用的上行文，重點在於你要建議長官怎麼決定。
  </p>
  <ul class="rules">
    {sign.sections.map((t) => <li>{t}</li>)}
  </ul>

  <h3>什麼時候先簽後稿、什麼時候簽稿併陳</h3>
  <p><strong>先簽後稿</strong>（先簽請核准，再擬公文稿）：</p>
  <ul class="rules">
    {sign.modes.signFirst.map((t) => <li>{t}</li>)}
  </ul>
  <p><strong>簽稿併陳</strong>（簽與稿一起陳核）：</p>
  <ul class="rules">
    {sign.modes.together.map((t) => <li>{t}</li>)}
  </ul>
  <p class="note"><strong>以稿代簽</strong>：{sign.modes.draftOnly}</p>

  <h3>簽的款式</h3>
  <ul class="rules">
    {sign.style.map((t) => <li>{t}</li>)}
  </ul>

  <h2 id={S.announce.id}>{S.announce.label}</h2>
  <p>
    公告既不是函的「辦法」，也不是簽的「擬辦」——它的三段是
    <strong>主旨、依據、公告事項</strong>。依據段引據法規條文名稱或機關來函；
    公告事項段分項條列。內容僅就主旨補充事實經過或理由時，段名才改用「說明」。
    <strong>公告沒有「辦法」段。</strong>
  </p>
  <p class="note">
    三種文別的段名對照，以及各文別的用印方式，整理在<a href={`${base}doc-types/`}>文別怎麼選</a>。
  </p>

  <h2 id={S.fields.id}>{S.fields.label}</h2>
  <p>
    三段式講的是正文，但稿紙上還有一排欄位要填，而且填錯會直接影響對方怎麼辦這件事 ——
    速別決定人家多快處理，密等決定這份文能不能給第三人看，正本與副本決定誰有義務辦、誰只是知道。
    這幾格手冊逐一寫過怎麼填。
  </p>
  <dl class="fields">
    {workflow.draftFields.map((t) => {
      const [name, ...rest] = t.split('：');
      return (
        <>
          <dt>{name}</dt>
          <dd>{rest.join('：')}</dd>
        </>
      );
    })}
  </dl>
  <p class="note">
    這 {workflow.draftFields.length} 項是稿面欄位。附件的檢點與編號、特殊處理事項（刊登公報、
    出版品揭示）另有規定，條文在手冊同一點的後半，本站不轉述 —— 看<a href={source.url} rel="noopener">官方原檔</a>。
  </p>

  <h2 id={S.cautions.id}>{S.cautions.label}</h2>
  <ol class="rules">
    {drafting.cautions.map((t) => <li>{t}</li>)}
  </ol>

  <h2 id={S.numbers.id}>{S.numbers.label}</h2>
  <p>
    公文書橫式書寫數字使用原則的三條規則。金額寫成「新臺幣伍拾萬元整」屬於慣用語與防竄改
    的另一套要求，不在這三條之內。
  </p>
  <ol class="rules">
    {numberRules.map((t) => <li>{t}</li>)}
  </ol>
  <p class="note">
    這三條講的是「該用哪一種」。手上已經有一個數字要換成國字大寫（金額、支票、核銷憑證），
    對照表與換算在<a href={`${base}numbers/`}>數字大寫怎麼寫</a>。
  </p>
  <p class="note">
    完整的數字用法舉例一覽表在手冊附錄 5，
    本站不重製那張表（兩層表頭的合併儲存格，機器解出來的對照關係不可靠）——
    請看<a href={source.url} rel="noopener">官方原檔</a>。
  </p>

  <h2 id={S.flow.id}>{S.flow.label}</h2>
  <p>
    稿擬好不等於事情辦完。手冊把文書處理拆成 {workflow.steps.length} 個步驟，
    承辦寫的那一段只在第二、三步；接下來稿子會經過主管初核、上級覆核、相關單位會稿，
    再由文書單位閱稿，最後依分層負責由有權者判行。
  </p>
  <ol class="rules">
    {workflow.steps.map((t) => <li>{t}</li>)}
  </ol>

  <h3>陳核：誰簽在哪一格</h3>
  <ul class="rules">
    {workflow.stages.submit.map((t) => <li>{t}</li>)}
  </ul>

  <h3>核稿：主管改稿的規矩</h3>
  <ul class="rules">
    {workflow.stages.review.map((t) => <li>{t}</li>)}
  </ul>

  <h3>會稿：送會出去以後</h3>
  <p class="note">
    最容易吃虧的是第二條 —— <strong>沒表示意見就等於同意，而且要共同負責</strong>。
  </p>
  <ul class="rules">
    {workflow.stages.joint.map((t) => <li>{t}</li>)}
  </ul>

  <h3>閱稿：文書單位會看的 {workflow.stages.proofread.length} 件事</h3>
  <p>
    這是官方版的人工檢查清單。本站的<a href={`${base}checks/`}>格式檢核</a>對得上其中幾條 ——
    程式、數字、標點與引用法規條文正不正確、有沒有錯別字，機器可以先過一遍。
    對不上的幾條（簽稿是否相符、前後案情是否連貫、有關單位已否會洽）要人看，
    因為那要知道這個案子先前發生過什麼。
  </p>
  <ol class="rules">
    {workflow.stages.proofread.map((t) => <li>{t}</li>)}
  </ol>

  <h3>判行：批「發」、「不發」還是「緩發」</h3>
  <ul class="rules">
    {workflow.stages.approve.map((t) => <li>{t}</li>)}
  </ul>
  <p class="note">
    這一整條流程都在機關的電子公文系統裡走。近年各縣市導入的 AI 工具接的是前面擬稿那一段，
    沒有一套去動這幾關 —— 現況與行政院訂的界線在<a href={`${base}ai-official-document/`}>AI 寫公文現在做到哪</a>。
  </p>

  <h2 id={S.quality.id}>{S.quality.label}</h2>
  <p>公文程式條例第 8 條要求「簡、淺、明、確」，手冊把它拆成七項作業要求。</p>
  <ul class="rules">
    {drafting.quality.map((t) => <li>{t}</li>)}
  </ul>

  <h2 id={S.examples.id}>{S.examples.label}</h2>
  <ul class="examples">
    {showcase.map((c) => (
      <li>
        <a href={`${base}cases/${c.slug}/`}>{c.seoTitle}</a>
        <span>{c.lead}</span>
      </li>
    ))}
  </ul>
  <p class="note">
    每一則都附<a href={`${base}checks/`}>格式檢核</a>逐條結果 —— 規則有沒有被遵守，看得到。
    完整清單在<a href={`${base}cases/`}>公文範例庫</a>；
    文別怎麼挑看<a href={`${base}doc-types/`}>文別怎麼選</a>；
    空白範本在<a href={`${base}templates/`}>範本下載</a>。
  </p>

  <p class="verified">
    資料產生日期：{generated}。來源：{source.issuer}《{source.name}》{source.edition}。
    手冊改版時重跑 <code>pnpm gen:gov-terms</code>。
  </p>
</ArticlePage>

<style>
  .cross {
    background: var(--color-bg-light);
    padding: 1rem 1.25rem;
    border-radius: 0.375rem;
  }
  .seg {
    margin-block: 2rem;
  }
  blockquote {
    margin: 0.75rem 0 0;
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--color-primary);
    background: var(--color-bg-light);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: 2;
  }
  .rules li {
    margin-block: 0.75rem;
    line-height: 1.9;
  }
  .examples {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .examples li {
    display: grid;
    gap: 0.25rem;
  }
  .examples span {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .fields {
    display: grid;
    gap: 0.5rem 1rem;
    margin-block: 1.5rem;
  }
  .fields dt {
    font-weight: 600;
    margin-top: 0.75rem;
  }
  .fields dd {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.9;
    color: var(--color-ink-soft);
  }
  .note {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .verified {
    margin-top: 3rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
</style>
