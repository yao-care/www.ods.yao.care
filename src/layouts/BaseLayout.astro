---
import '../styles/variables.css';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { ORG_SAME_AS } from '../site.config.js';
import ogManifest from '../data/og.json';

interface Props {
  title: string;
  description?: string;
  /** 單頁自己的 JSON-LD。全站共用的 Organization／WebSite 已由本層給。 */
  schemas?: unknown[];
}
const { title, description, schemas = [] } = Astro.props;
// 站內絕對路徑一律用 base 組：模式 A 時 BASE_URL='/'（行為不變），模式 B 才不會掉到主機根目錄。
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL('/', Astro.site).href;

// 分享圖：每頁一張 1200×630，由 scripts/gen-brand-images.py 產生並 commit，
// 清單在 src/data/og.json。1200 寬是 Google Discover 大圖版位的硬門檻，
// 而且要配下面的 max-image-preview:large 才吃得到；缺一不可。
// 對不到的路由（例如 404）退回首頁那張，不留空的 og:image。
const ogEntry = ogManifest[Astro.url.pathname] ?? ogManifest['/'];
const ogImage = new URL(`${base}${ogEntry.file}`, Astro.site).href;
/**
 * 把分享圖補進單頁 schema 的主節點。
 * 為什麼在這裡做而不是每頁手加：Article／CollectionPage／ContactPage 分散在十幾支檔，
 * 逐一加等於開十幾個會漂移的點；而且圖是 BaseLayout 決定的，決定權跟寫入權放同一處。
 */
const IMAGEABLE = new Set(['Article', 'CollectionPage', 'ContactPage', 'WebPage']);
const withImage = (schema) => {
  if (!schema || typeof schema !== 'object') return schema;
  const nodes = Array.isArray(schema['@graph']) ? schema['@graph'] : [schema];
  for (const node of nodes) {
    if (IMAGEABLE.has(node?.['@type']) && !node.image) {
      node.image = { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 };
    }
  }
  return schema;
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.yao.care/#organization',
      name: '藥提醒科技有限公司',
      legalName: '藥提醒科技有限公司',
      url: 'https://www.yao.care/',
      sameAs: ORG_SAME_AS,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: '公文 AI｜正式文書與格式檢核',
      description: '機關公文、民眾對機關書件、存證信函與格式檢核。',
      publisher: { '@id': 'https://www.yao.care/#organization' },
      inLanguage: 'zh-Hant-TW',
    },
  ],
};
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <!-- 沒有這一行，Discover 與搜尋結果只會給縮圖版位，1200 寬的圖等於白做 -->
    <meta name="robots" content="max-image-preview:large" />

    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="公文 AI" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(withImage(schema))} />
    ))}
    <Analytics />
  </head>
  <body>
    <!--
      跳過導覽（2026-08-20）。導覽列有 25 個連結，沒有這一條的話，純鍵盤或螢幕閱讀器
      使用者每進一頁都要 tab 過那 25 個才碰得到內文。機關的無障礙檢核也會看這一項。
      平常視覺上不存在，一拿到焦點才出現在左上角。
      #main 在每一頁都要有落點 —— 由 pnpm check:anchors 自動守門。
    -->
    <a class="skip-link" href="#main">跳到主要內容</a>
    <slot />
  </body>
</html>
