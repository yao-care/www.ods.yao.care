---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseDemo from '../../components/CaseDemo.astro';
import { CASES } from '../../data/cases.js';
import index from '../../data/scenarios.json';

const payloads = import.meta.glob('../../data/scenarios/*.json', { eager: true });

export async function getStaticPaths() {
  const { CASES } = await import('../../data/cases.js');
  return CASES.map((c) => ({ params: { slug: c.slug }, props: { caseMeta: c } }));
}

const { caseMeta } = Astro.props;
const payload = payloads[`../../data/scenarios/${caseMeta.key}.json`].default;
const listing = index.items.find((i) => i.key === caseMeta.key);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const related = CASES.filter((c) => c.category === caseMeta.category && c.slug !== caseMeta.slug);
const failed = payload.checks.filter((c) => !c.ok);

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${caseMeta.seoTitle}要用哪一種文別？`,
      acceptedAnswer: { '@type': 'Answer', text: `這類案子用「${payload.draft.doc_type}」。${caseMeta.lead}` },
    },
    {
      '@type': 'Question',
      name: `${caseMeta.seoTitle}要注意什麼？`,
      acceptedAnswer: { '@type': 'Answer', text: caseMeta.watchOut.join('；') + '。' },
    },
  ],
};
---

<BaseLayout
  title={`${caseMeta.seoTitle}｜公文 AI`}
  description={`${caseMeta.lead} 提供完整${payload.draft.doc_type}範例全文與 24 條格式檢核結果。`}
>
  <SiteHeader />
  <main>
    <nav class="crumb" aria-label="麵包屑">
      <a href={`${base}cases/`}>公文範例</a> <span>/</span> <span>{caseMeta.category}</span>
    </nav>

    <h1>{caseMeta.seoTitle}</h1>
    <p class="lead">{caseMeta.lead}</p>

    <dl class="facts">
      <div><dt>文別</dt><dd>{payload.draft.doc_type}</dd></div>
      <div><dt>受文者</dt><dd>{listing?.receiver ?? '無'}</dd></div>
      <div><dt>格式檢核</dt><dd>{payload.checks.length - failed.length}/{payload.checks.length} 通過</dd></div>
    </dl>

    <h2>試做這個案例</h2>
    <p class="note">流程與實際使用相同。範例內容可以看，改成自己的案子需要帳號。</p>
    <CaseDemo
      scenario={payload.scenario}
      draft={payload.draft}
      checks={payload.checks}
      receiver={listing?.receiver ?? null}
    />

    <h2>這類案子常踩的點</h2>
    <ul class="watch">
      {caseMeta.watchOut.map((w) => <li>{w}</li>)}
    </ul>
    <p class="note">
      這些都在 <a href={`${base}checks/`}>24 條格式檢核</a>的涵蓋範圍，
      用語依據見<a href={`${base}terms/`}>用語與法規速查</a>。
    </p>

    {related.length > 0 && (
      <>
        <h2>同類案例</h2>
        <ul class="related">
          {related.map((r) => (
            <li><a href={`${base}cases/${r.slug}/`}>{r.seoTitle}</a></li>
          ))}
        </ul>
      </>
    )}

    <section class="cta-box">
      <h2>用貴機關自己的案子試試</h2>
      <p>
        接上機關既有稿件後，草擬會沿用貴機關的慣用語與課室署名。
        機關由我們開通帳號；社區發展協會、學校家長會這類小型單位可以自己註冊。
      </p>
      <div class="cta-row">
        <a class="primary" href={`${base}apply/`}>機關申請試用</a>
        <a class="secondary" href="https://app.ods.yao.care/">小型單位自助註冊</a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
</BaseLayout>

<style>
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .crumb {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .crumb a {
    color: var(--color-primary);
  }
  h1 {
    font-size: var(--text-2xl);
    line-height: 1.3;
  }
  h2 {
    font-size: var(--text-xl);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .lead {
    font-size: var(--text-base);
    line-height: 1.9;
    color: var(--color-ink-soft);
    margin-top: 1rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 1.5rem 0 0;
    padding: 1rem 0;
    border-block: 1px solid var(--color-line);
  }
  .facts dt {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .facts dd {
    font-size: var(--text-sm);
    margin: 0;
  }
  .note {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: 1rem;
  }
  .watch,
  .related {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.5rem;
  }
  .watch li,
  .related li {
    font-size: var(--text-base);
    line-height: 1.8;
  }
  .cta-box {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 0.5rem;
    background: var(--color-bg-light);
  }
  .cta-box h2 {
    margin-top: 0;
  }
  .cta-box p {
    font-size: var(--text-base);
    line-height: 1.9;
    margin-bottom: 1.5rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .primary {
    font-size: var(--text-base);
    background: var(--color-accent);
    color: var(--color-white);
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    text-decoration: none;
  }
  .primary:hover {
    background: var(--color-accent-dark);
  }
  .secondary {
    font-size: var(--text-sm);
    color: var(--color-primary);
  }
</style>
